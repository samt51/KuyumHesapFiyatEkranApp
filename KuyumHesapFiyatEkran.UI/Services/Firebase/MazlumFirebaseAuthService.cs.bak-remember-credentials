using System.Net.Http.Json;
using System.Text.Json;
using Microsoft.Maui.Storage;

namespace KuyumHesapFiyatEkran.UI.Services.Firebase;

public sealed class MazlumFirebaseAuthService
    : IMazlumFirebaseAuthService
{
    private const string ApiKey =
        "AIzaSyBks-QvliWR8TBzvIltamfefmP0oNWCQLI";

    private const string EmailKey =
        "mazlum_auth_email";

    private const string IdTokenKey =
        "mazlum_auth_id_token";

    private const string RefreshTokenKey =
        "mazlum_auth_refresh_token";

    private const string RememberKey =
        "mazlum_auth_remember";

    private readonly HttpClient httpClient;

    private string? idToken;
    private string? refreshToken;

    public MazlumFirebaseAuthService(
        IHttpClientFactory httpClientFactory)
    {
        httpClient = httpClientFactory.CreateClient();
    }

    public bool IsAuthenticated =>
        !string.IsNullOrWhiteSpace(UserEmail) &&
        !string.IsNullOrWhiteSpace(idToken);

    public string? UserEmail { get; private set; }

    public async Task<MazlumAuthResult> SignInAsync(
        string email,
        string password,
        bool remember)
    {
        email = email.Trim();

        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(password))
        {
            return new MazlumAuthResult
            {
                Success = false,
                ErrorMessage = "E-posta ve şifre zorunludur."
            };
        }

        try
        {
            var url =
                $"https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={ApiKey}";

            var request = new
            {
                email,
                password,
                returnSecureToken = true
            };

            using var response =
                await httpClient.PostAsJsonAsync(
                    url,
                    request);

            var json =
                await response.Content.ReadAsStringAsync();

            if (!response.IsSuccessStatusCode)
            {
                return new MazlumAuthResult
                {
                    Success = false,
                    ErrorMessage =
                        MapFirebaseError(json)
                };
            }

            using var document =
                JsonDocument.Parse(json);

            var root =
                document.RootElement;

            UserEmail =
                root.TryGetProperty(
                    "email",
                    out var emailElement)
                    ? emailElement.GetString()
                    : email;

            idToken =
                root.TryGetProperty(
                    "idToken",
                    out var idTokenElement)
                    ? idTokenElement.GetString()
                    : null;

            refreshToken =
                root.TryGetProperty(
                    "refreshToken",
                    out var refreshTokenElement)
                    ? refreshTokenElement.GetString()
                    : null;

            if (remember)
            {
                await SecureStorage.Default.SetAsync(
                    EmailKey,
                    UserEmail ?? email);

                await SecureStorage.Default.SetAsync(
                    IdTokenKey,
                    idToken ?? string.Empty);

                await SecureStorage.Default.SetAsync(
                    RefreshTokenKey,
                    refreshToken ?? string.Empty);

                Preferences.Default.Set(
                    RememberKey,
                    true);
            }
            else
            {
                Preferences.Default.Set(
                    RememberKey,
                    false);

                SecureStorage.Default.Remove(
                    EmailKey);

                SecureStorage.Default.Remove(
                    IdTokenKey);

                SecureStorage.Default.Remove(
                    RefreshTokenKey);
            }

            return new MazlumAuthResult
            {
                Success = true,
                Email = UserEmail
            };
        }
        catch
        {
            return new MazlumAuthResult
            {
                Success = false,
                ErrorMessage =
                    "Giriş yapılamadı. Tekrar deneyin."
            };
        }
    }

    public async Task RestoreSessionAsync()
    {
        if (!Preferences.Default.Get(
                RememberKey,
                false))
        {
            ClearMemorySession();
            return;
        }

        try
        {
            UserEmail =
                await SecureStorage.Default.GetAsync(
                    EmailKey);

            idToken =
                await SecureStorage.Default.GetAsync(
                    IdTokenKey);

            refreshToken =
                await SecureStorage.Default.GetAsync(
                    RefreshTokenKey);

            if (string.IsNullOrWhiteSpace(UserEmail) ||
                string.IsNullOrWhiteSpace(idToken))
            {
                await SignOutAsync();
            }
        }
        catch
        {
            ClearMemorySession();
        }
    }

    public async Task<string?> GetIdTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(refreshToken))
            return idToken;

        try
        {
            var url =
                $"https://securetoken.googleapis.com/v1/token?key={ApiKey}";

            using var content =
                new FormUrlEncodedContent(
                    new Dictionary<string, string>
                    {
                        ["grant_type"] = "refresh_token",
                        ["refresh_token"] = refreshToken
                    });

            using var response =
                await httpClient.PostAsync(url, content);

            if (!response.IsSuccessStatusCode)
                return idToken;

            var json =
                await response.Content.ReadAsStringAsync();

            using var document =
                JsonDocument.Parse(json);

            var root = document.RootElement;

            var newIdToken =
                root.TryGetProperty(
                    "id_token",
                    out var idTokenElement)
                    ? idTokenElement.GetString()
                    : null;

            var newRefreshToken =
                root.TryGetProperty(
                    "refresh_token",
                    out var refreshTokenElement)
                    ? refreshTokenElement.GetString()
                    : null;

            if (!string.IsNullOrWhiteSpace(newIdToken))
                idToken = newIdToken;

            if (!string.IsNullOrWhiteSpace(newRefreshToken))
                refreshToken = newRefreshToken;

            if (Preferences.Default.Get(
                    RememberKey,
                    false))
            {
                if (!string.IsNullOrWhiteSpace(idToken))
                {
                    await SecureStorage.Default.SetAsync(
                        IdTokenKey,
                        idToken);
                }

                if (!string.IsNullOrWhiteSpace(refreshToken))
                {
                    await SecureStorage.Default.SetAsync(
                        RefreshTokenKey,
                        refreshToken);
                }
            }

            return idToken;
        }
        catch
        {
            return idToken;
        }
    }

    public Task SignOutAsync()
    {
        ClearMemorySession();

        Preferences.Default.Remove(
            RememberKey);

        SecureStorage.Default.Remove(
            EmailKey);

        SecureStorage.Default.Remove(
            IdTokenKey);

        SecureStorage.Default.Remove(
            RefreshTokenKey);

        return Task.CompletedTask;
    }

    private void ClearMemorySession()
    {
        UserEmail = null;
        idToken = null;
        refreshToken = null;
    }

    private static string MapFirebaseError(
        string json)
    {
        try
        {
            using var document =
                JsonDocument.Parse(json);

            var message =
                document.RootElement
                    .GetProperty("error")
                    .GetProperty("message")
                    .GetString();

            return message switch
            {
                "INVALID_EMAIL" =>
                    "Geçersiz e-posta adresi.",

                "EMAIL_NOT_FOUND" =>
                    "E-posta veya şifre hatalı.",

                "INVALID_PASSWORD" =>
                    "E-posta veya şifre hatalı.",

                "INVALID_LOGIN_CREDENTIALS" =>
                    "E-posta veya şifre hatalı.",

                "USER_DISABLED" =>
                    "Bu hesap devre dışı.",

                "TOO_MANY_ATTEMPTS_TRY_LATER" =>
                    "Çok fazla deneme. Bir süre sonra tekrar deneyin.",

                _ =>
                    "Giriş yapılamadı. Tekrar deneyin."
            };
        }
        catch
        {
            return "Giriş yapılamadı. Tekrar deneyin.";
        }
    }
}
