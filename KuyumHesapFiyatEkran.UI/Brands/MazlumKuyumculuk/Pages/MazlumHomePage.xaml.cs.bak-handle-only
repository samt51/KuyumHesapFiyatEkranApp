    private IEnumerable<MazlumFirebasePrice> ApplyCustomPriceOrder(
        IEnumerable<MazlumFirebasePrice> source)
    {
        var items =
            source
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Name)
                .ToList();

        var savedOrder =
            Preferences.Default.Get(
                PriceOrderPreferenceKey,
                string.Empty);

        if (string.IsNullOrWhiteSpace(savedOrder))
        {
            return items;
        }

        var ids =
            savedOrder
                .Split(
                    '|',
                    StringSplitOptions.RemoveEmptyEntries |
                    StringSplitOptions.TrimEntries)
                .ToList();

        if (ids.Count == 0)
        {
            return items;
        }

        var positions =
            ids
                .Select((id, index) => new { id, index })
                .GroupBy(x => x.id)
                .ToDictionary(
                    x => x.Key,
                    x => x.First().index,
                    StringComparer.OrdinalIgnoreCase);

        return items
            .OrderBy(
                x => positions.TryGetValue(
                    x.Id,
                    out var position)
                        ? position
                        : int.MaxValue)
            .ThenBy(x => x.Order)
            .ThenBy(x => x.Name)
            .ToList();
    }

    private void SaveCurrentPriceOrder(
        IReadOnlyList<MazlumFirebasePrice> prices)
    {
        var order =
            string.Join(
                "|",
                prices
                    .Where(x => !string.IsNullOrWhiteSpace(x.Id))
                    .Select(x => x.Id));

        Preferences.Default.Set(
            PriceOrderPreferenceKey,
            order);
    }

    private void OnPriceDragStarting(
        object sender,
        DragStartingEventArgs e)
    {
        if (sender is not DragGestureRecognizer dragGesture ||
            dragGesture.BindingContext is not MazlumPriceRow row)
        {
            e.Cancel = true;
            return;
        }

        draggedPriceId = row.Id;

        e.Data.Properties["MazlumPriceId"] =
            row.Id;
    }

    private void OnPriceDragOver(
        object sender,
        DragEventArgs e)
    {
        e.AcceptedOperation =
            DataPackageOperation.Copy;
    }

    private void OnPriceDropped(
        object sender,
        DropEventArgs e)
    {
        try
        {
            if (sender is not DropGestureRecognizer dropGesture ||
                dropGesture.BindingContext is not MazlumPriceRow targetRow)
            {
                return;
            }

            var sourceId =
                draggedPriceId;

            if (string.IsNullOrWhiteSpace(sourceId) ||
                string.Equals(
                    sourceId,
                    targetRow.Id,
                    StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            var ordered =
                ApplyCustomPriceOrder(allPrices)
                    .ToList();

            var sourceIndex =
                ordered.FindIndex(
                    x => string.Equals(
                        x.Id,
                        sourceId,
                        StringComparison.OrdinalIgnoreCase));

            var targetIndex =
                ordered.FindIndex(
                    x => string.Equals(
                        x.Id,
                        targetRow.Id,
                        StringComparison.OrdinalIgnoreCase));

            if (sourceIndex < 0 ||
                targetIndex < 0)
            {
                return;
            }

            var moving =
                ordered[sourceIndex];

            ordered.RemoveAt(sourceIndex);

            targetIndex =
                ordered.FindIndex(
                    x => string.Equals(
                        x.Id,
                        targetRow.Id,
                        StringComparison.OrdinalIgnoreCase));

            if (targetIndex < 0)
            {
                return;
            }

            ordered.Insert(
                targetIndex,
                moving);

            SaveCurrentPriceOrder(ordered);

            ShowCurrentTab();
        }
        finally
        {
            draggedPriceId = null;
        }
    }

    private async void OnPriceSelected(
        object sender,
        SelectionChangedEventArgs e)
    {
        if (e.CurrentSelection.FirstOrDefault()
            is not MazlumPriceRow row)
        {
            return;
        }

        if (sender is CollectionView collectionView)
        {
            collectionView.SelectedItem = null;
        }

        await Navigation.PushAsync(
            new MazlumDetailPage(
                row.Source,
                favoritesService));
    }

