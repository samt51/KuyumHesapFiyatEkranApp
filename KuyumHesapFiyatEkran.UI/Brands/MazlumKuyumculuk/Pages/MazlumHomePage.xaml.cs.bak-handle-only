        public MazlumFirebasePrice Source { get; init; } =
            null!;

        public string Name { get; init; } =
            string.Empty;

        public string Buy { get; init; } =
            string.Empty;

        public string Sell { get; init; } =
            string.Empty;

        public string BuyChangeDisplay { get; init; } =
            string.Empty;

        public string SellChangeDisplay { get; init; } =
            string.Empty;

        public Color BuyChangeColor { get; init; } =
            Colors.Transparent;

        public Color SellChangeColor { get; init; } =
            Colors.Transparent;
    }

    private async Task RestoreAuthSessionIfNeededAsync()
    {
        if (authService.IsAuthenticated)
        {
            return;
        }

        try
        {
            await authService.RestoreSessionAsync();
        }
        catch
        {
            // Kayitli oturum okunamazsa kullanici
            // giris yapmamis gibi devam eder.
        }
    }

    private void UpdateAuthUi()
    {
        var isAuthenticated =
            authService.IsAuthenticated &&
            !string.IsNullOrWhiteSpace(authService.UserEmail);

        var email = authService.UserEmail?.Trim();

        AuthUserLabel.Text =
            isAuthenticated
                ? email
                : "Giriş Yap";

        LogoutMenuRow.IsVisible = isAuthenticated;

        var isAdmin =
            isAuthenticated &&
            string.Equals(
                email,
                "admin@mazlumkuyumculuk.com",
                StringComparison.OrdinalIgnoreCase);

        NotificationMenuRow.IsVisible = isAdmin;
    }

    private async void OnAuthMenuTapped(
        object sender,
        TappedEventArgs e)
    {
        await CloseSidebarAsync();

        if (authService.IsAuthenticated)
        {
            return;
        }

        var page =
            Handler?.MauiContext?.Services
                .GetService<MazlumLoginChooserPage>();

        if (page is null)
        {
            await DisplayAlert(
                "Hata",
                "Giriş ekranı açılamadı.",
                "Tamam");

            return;
        }

        await Navigation.PushAsync(page);
    }

    private async void OnLogoutTapped(
        object sender,
        TappedEventArgs e)
    {
        await CloseSidebarAsync();

        try
        {
            await authService.SignOutAsync();
            UpdateAuthUi();
        }
        catch
        {
            await DisplayAlert(
                "Hata",
                "Çıkış yapılamadı. Tekrar deneyin.",
                "Tamam");
        }
    }

