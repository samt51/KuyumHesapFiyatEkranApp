using KuyumHesapFiyatEkran.UI.Services.Firebase;

namespace KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages;

public partial class MazlumSettingsPage : ContentPage
{
    private const string HomeFavoritesPreferenceKey =
        "mazlum-home-favorites";

    private const string AdminEmail =
        "admin@mazlumkuyumculuk.com";

    private readonly IMazlumFirebaseService firebaseService;
    private readonly IMazlumFirebaseAuthService authService;

    private bool loading;
    private bool contactLoading;

    public MazlumSettingsPage(
        IMazlumFirebaseService firebaseService,
        IMazlumFirebaseAuthService authService)
    {
        InitializeComponent();

        this.firebaseService = firebaseService;
        this.authService = authService;
    }

    protected override async void OnAppearing()
    {
        base.OnAppearing();

        NavigationPage.SetHasNavigationBar(this, false);
        Shell.SetNavBarIsVisible(this, false);

        loading = true;

        HomeFavoritesCheckBox.IsChecked =
            Preferences.Default.Get(
                HomeFavoritesPreferenceKey,
                false);

        ActiveThemeLabel.Text =
            Application.Current?.RequestedTheme == AppTheme.Light
                ? "Açık"
                : "Koyu";

        loading = false;

        await LoadContactAsync();
    }

    private async Task LoadContactAsync()
    {
        if (contactLoading)
            return;

        contactLoading = true;

        try
        {
            var contact =
                await firebaseService.GetContactAsync();

            PhoneDisplayEntry.Text =
                contact.PhoneDisplay;

            InstagramEntry.Text =
                contact.Instagram;

            WhatsappEntry.Text =
                contact.Whatsapp;

            var isAdmin =
                authService.IsAuthenticated &&
                string.Equals(
                    authService.UserEmail?.Trim(),
                    AdminEmail,
                    StringComparison.OrdinalIgnoreCase);

            PhoneDisplayEntry.IsReadOnly = !isAdmin;
            InstagramEntry.IsReadOnly = !isAdmin;
            WhatsappEntry.IsReadOnly = !isAdmin;

            SaveContactButton.IsVisible = isAdmin;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(
                $"Contact load error: {ex}");
        }
        finally
        {
            contactLoading = false;
        }
    }

    private async void OnSaveContactClicked(
        object? sender,
        EventArgs e)
    {
        var isAdmin =
            authService.IsAuthenticated &&
            string.Equals(
                authService.UserEmail?.Trim(),
                AdminEmail,
                StringComparison.OrdinalIgnoreCase);

        if (!isAdmin)
        {
            await DisplayAlert(
                "Yetki",
                "İletişim bilgilerini yalnızca yönetici güncelleyebilir.",
                "Tamam");

            return;
        }

        SaveContactButton.IsEnabled = false;
        SaveContactButton.Text = "Kaydediliyor...";

        try
        {
            var token =
                await authService.GetIdTokenAsync();

            if (string.IsNullOrWhiteSpace(token))
            {
                await DisplayAlert(
                    "Oturum",
                    "Yönetici oturumu yenilenemedi. Lütfen tekrar giriş yapın.",
                    "Tamam");

                return;
            }

            var contact = NormalizeContact(
                PhoneDisplayEntry.Text,
                InstagramEntry.Text,
                WhatsappEntry.Text);

            await firebaseService.SaveContactAsync(
                contact,
                token);

            PhoneDisplayEntry.Text =
                contact.PhoneDisplay;

            InstagramEntry.Text =
                contact.Instagram;

            WhatsappEntry.Text =
                contact.Whatsapp;

            await DisplayAlert(
                "İletişim",
                "İletişim bilgileri güncellendi.",
                "Tamam");
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(
                $"Contact save error: {ex}");

            await DisplayAlert(
                "Hata",
                "İletişim bilgileri kaydedilemedi.",
                "Tamam");
        }
        finally
        {
            SaveContactButton.IsEnabled = true;
            SaveContactButton.Text = "İletişimi kaydet";
        }
    }

    private static MazlumFirebaseContact NormalizeContact(
        string? phoneDisplayRaw,
        string? instagramRaw,
        string? whatsappRaw)
    {
        var scheme =
            "https:" + "//";

        var defaultPhoneDisplay =
            "0555 123 45 67";

        var phoneDisplay =
            string.IsNullOrWhiteSpace(phoneDisplayRaw)
                ? defaultPhoneDisplay
                : phoneDisplayRaw.Trim();

        var digits =
            new string(
                phoneDisplay
                    .Where(char.IsDigit)
                    .ToArray());

        string withCountry;

        if (digits.StartsWith("0") &&
            digits.Length >= 10)
        {
            withCountry =
                "90" + digits[1..];
        }
        else if (digits.StartsWith("90"))
        {
            withCountry = digits;
        }
        else if (digits.Length == 10)
        {
            withCountry =
                "90" + digits;
        }
        else
        {
            withCountry =
                "905551234567";
        }

        var instagram =
            instagramRaw?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(instagram))
        {
            instagram =
                scheme +
                "www.instagram.com/mazlumkuyumculuk";
        }
        else if (
            !instagram.StartsWith(
                "http://",
                StringComparison.OrdinalIgnoreCase) &&
            !instagram.StartsWith(
                scheme,
                StringComparison.OrdinalIgnoreCase))
        {
            instagram =
                scheme +
                "www.instagram.com/" +
                instagram.TrimStart('@', '/');
        }

        var whatsapp =
            whatsappRaw?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(whatsapp))
        {
            whatsapp =
                scheme +
                "wa.me/" +
                withCountry;
        }
        else if (
            !whatsapp.StartsWith(
                "http://",
                StringComparison.OrdinalIgnoreCase) &&
            !whatsapp.StartsWith(
                scheme,
                StringComparison.OrdinalIgnoreCase))
        {
            var whatsappDigits =
                new string(
                    whatsapp
                        .Where(char.IsDigit)
                        .ToArray());

            if (whatsappDigits.StartsWith("0"))
                whatsappDigits =
                    "90" + whatsappDigits[1..];

            if (whatsappDigits.Length == 10)
                whatsappDigits =
                    "90" + whatsappDigits;

            if (string.IsNullOrWhiteSpace(whatsappDigits))
                whatsappDigits = withCountry;

            whatsapp =
                scheme +
                "wa.me/" +
                whatsappDigits;
        }

        return new MazlumFirebaseContact
        {
            Phone =
                "+" + withCountry,

            PhoneDisplay =
                phoneDisplay,

            Instagram =
                instagram,

            Whatsapp =
                whatsapp
        };
    }

    private async void OnBackTapped(
        object? sender,
        TappedEventArgs e)
    {
        if (Navigation.NavigationStack.Count > 1)
            await Navigation.PopAsync();
    }

    private async void OnMenuTapped(
        object? sender,
        TappedEventArgs e)
    {
        await DisplayAlert(
            "Ayarlar",
            "Menü bağlantısı hazırlanıyor.",
            "Tamam");
    }

    private void OnDarkThemeTapped(
        object? sender,
        TappedEventArgs e)
    {
        ActiveThemeLabel.Text = "Koyu";

        Application.Current!.UserAppTheme =
            AppTheme.Dark;
    }

    private void OnLightThemeTapped(
        object? sender,
        TappedEventArgs e)
    {
        ActiveThemeLabel.Text = "Açık";

        Application.Current!.UserAppTheme =
            AppTheme.Light;
    }

    private void OnHomeFavoritesChanged(
        object? sender,
        CheckedChangedEventArgs e)
    {
        if (loading)
            return;

        Preferences.Default.Set(
            HomeFavoritesPreferenceKey,
            e.Value);
    }

    private async void OnTvModeTapped(
        object? sender,
        TappedEventArgs e)
    {
        var services =
            Handler?.MauiContext?.Services;

        if (services is null)
            return;

        var page =
            services.GetRequiredService<MazlumTvPage>();

        await Navigation.PushAsync(page);
    }

    private async void OnNotificationsClicked(
        object? sender,
        EventArgs e)
    {
        await DisplayAlert(
            "Bildirimler",
            "Firebase native bildirim yapılandırması tamamlandığında bu özellik aktif olacak.",
            "Tamam");
    }
}
