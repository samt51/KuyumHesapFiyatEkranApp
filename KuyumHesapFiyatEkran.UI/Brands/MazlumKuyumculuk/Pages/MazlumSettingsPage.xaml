<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="18,12,18,14"
            ColumnDefinitions="42,42,*,74"
            ColumnSpacing="10">

            <Border
                Grid.Column="0"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 11">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="☰"
                    FontSize="22"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                Grid.Column="1"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 11">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="‹"
                    FontSize="28"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <Label
                Grid.Column="2"
                Grid.ColumnSpan="2"
                Text="Ayarlar"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{DynamicResource AppTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                Margin="0,0,52,0" />

        </Grid>

        <!-- CONTENT -->
        <ScrollView
            Grid.Row="1"
            BackgroundColor="{DynamicResource AppBackground}"
            VerticalOptions="FillAndExpand">

            <VerticalStackLayout
                Padding="20,12,20,42"
                Spacing="25"
                BackgroundColor="{DynamicResource AppBackground}"
                VerticalOptions="FillAndExpand">

                <!-- TEMA -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="TEMA"
                        FontSize="11"
                        CharacterSpacing="1.7"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Border
                        BackgroundColor="{DynamicResource AppActionBackground}"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="5">

                        <Grid
                            ColumnDefinitions="*,*"
                            HeightRequest="48"
                            ColumnSpacing="5">

                            <Border
                                x:Name="DarkThemeButton"
                                Grid.Column="0"
                                BackgroundColor="{DynamicResource AppAccentSoft}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDarkThemeTapped" />
                                </Border.GestureRecognizers>

                                <Label
                                    x:Name="DarkThemeLabel"
                                    Text="Koyu"
                                    FontSize="14"
                                    TextColor="{DynamicResource AppTextPrimary}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <Border
                                x:Name="LightThemeButton"
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLightThemeTapped" />
                                </Border.GestureRecognizers>

                                <Label
                                    x:Name="LightThemeLabel"
                                    Text="Açık"
                                    FontSize="14"
                                    TextColor="{DynamicResource AppTextPrimary}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                        </Grid>
                    </Border>

                </VerticalStackLayout>

                <!-- ANA SAYFA -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="ANA SAYFA"
                        FontSize="11"
                        CharacterSpacing="1.7"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Border
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,14">

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="4">

                                <Label
                                    Text="Ana sayfa favori listem"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppTextPrimary}" />

                                <Label
                                    Text="Açılışta favorileri göster"
                                    FontSize="12"
                                    TextColor="{DynamicResource AppTextMuted}" />

                            </VerticalStackLayout>

                            <CheckBox
                                x:Name="HomeFavoritesCheckBox"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Color="{DynamicResource AppAccent}"
                                CheckedChanged="OnHomeFavoritesChanged" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>

                <!-- EKRAN -->
                <VerticalStackLayout Spacing="9">

                    <Label
                        Text="EKRAN"
                        FontSize="11"
                        CharacterSpacing="1.7"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Border
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,14">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTvModeTapped" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="TV modu"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppTextPrimary}" />

                                <Label
                                    Text="Android TV / vitrin"
                                    FontSize="12"
                                    TextColor="{DynamicResource AppTextMuted}" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="→"
                                FontSize="18"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </Grid>

                    </Border>

                </VerticalStackLayout>

                <!-- BİLDİRİMLER -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="BİLDİRİMLER"
                        FontSize="11"
                        CharacterSpacing="1.7"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Grid
                        Padding="0,5"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="İzin durumu"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Label
                            x:Name="NotificationPermissionLabel"
                            Grid.Column="1"
                            Text="Henüz sorulmadı"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextPrimary}" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{DynamicResource AppBorder}" />

                    <Grid
                        Padding="0,5"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Uygulama bildirimleri"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Label
                            x:Name="NotificationEnabledLabel"
                            Grid.Column="1"
                            Text="Kapalı"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextPrimary}" />
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{DynamicResource AppBorder}" />

                    <Button
                        x:Name="NotificationsButton"
                        Text="Bildirimleri aç"
                        HeightRequest="50"
                        Margin="0,6,0,0"
                        BackgroundColor="{DynamicResource AppAccent}"
                        TextColor="#090909"
                        FontSize="14"
                        CornerRadius="12"
                        Clicked="OnNotificationsClicked" />

                </VerticalStackLayout>

                <!-- CONTACT -->
                <VerticalStackLayout
                    Margin="0,18,0,12"
                    Spacing="10">

                    <Label
                        Text="İLETİŞİM (MERKEZ)"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppAccent}" />

                    <Label
                        Text="Sidebar’daki telefon, Instagram ve WhatsApp bu alanlardan güncellenir."
                        FontSize="12"
                        LineHeight="1.25"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Label
                        Text="TELEFON"
                        Margin="0,6,0,0"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Border
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        Padding="12,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="PhoneDisplayEntry"
                            Placeholder="0555 123 45 67"
                            Keyboard="Telephone"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextPrimary}"
                            PlaceholderColor="{DynamicResource AppTextMuted}"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="INSTAGRAM"
                        Margin="0,5,0,0"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Border
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        Padding="12,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="InstagramEntry"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextPrimary}"
                            PlaceholderColor="{DynamicResource AppTextMuted}"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Label
                        Text="WHATSAPP"
                        Margin="0,5,0,0"
                        FontSize="11"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextMuted}" />

                    <Border
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        Padding="12,2">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="WhatsappEntry"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextPrimary}"
                            PlaceholderColor="{DynamicResource AppTextMuted}"
                            BackgroundColor="Transparent" />
                    </Border>

                    <Button
                        x:Name="SaveContactButton"
                        Text="İletişimi kaydet"
                        HeightRequest="50"
                        Margin="0,6,0,4"
                        BackgroundColor="{DynamicResource AppAccent}"
                        TextColor="#090909"
                        FontSize="14"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        Clicked="OnSaveContactClicked" />

                    <BoxView
                        Margin="0,5,0,0"
                        HeightRequest="1"
                        Color="{DynamicResource AppBorder}" />

                </VerticalStackLayout>

                <!-- INFO -->
                <VerticalStackLayout
                    Margin="0,5,0,0"
                    Spacing="0">

                    <Grid
                        Padding="0,12"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Aktif tema"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Label
                            x:Name="ActiveThemeLabel"
                            Grid.Column="1"
                            Text="Koyu"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource AppTextPrimary}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />

                    <Grid
                        Padding="0,12"
                        ColumnDefinitions="*,Auto">

                        <Label
                            Text="Veri kaynağı"
                            FontSize="14"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Label
                            Grid.Column="1"
                            Text="Firebase"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource AppTextPrimary}" />
                    </Grid>

                </VerticalStackLayout>

                <Label
                    Text="Sürüm 1.0.01"
                    Margin="0,2,0,0"
                    FontSize="11"
                    TextColor="{DynamicResource AppTextMuted}" />

            </VerticalStackLayout>
        </ScrollView>

    

        <Grid
            x:Name="SidebarOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="False"
            BackgroundColor="#99000000"
            ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>


            <!-- LEFT PANEL -->
            <Border
                x:Name="SidebarPanel"
                WidthRequest="330"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1"
                TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="22,32,18,22"
                    RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="12"
                    VerticalOptions="Fill">


                    <!-- ================= HEADER ================= -->

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="Auto,*,40"
                        ColumnSpacing="12">

                        <!-- MK LOGO -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            Stroke="{DynamicResource AppAccent}"
                            StrokeThickness="2"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label
                                    Text="mk"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    Margin="0,4,0,0" />

                                <Label
                                    Grid.Row="1"
                                    Text="ESTD 1998"
                                    FontSize="4"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,0,0,7" />

                            </Grid>

                        </Border>


                        <!-- WORDMARK -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">

                            <Label
                                Text="mazlum"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource AppAccent}" />

                            <Label
                                Text="KUYUMCULUK"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.6"
                                TextColor="{DynamicResource AppAccent}" />

                        </VerticalStackLayout>


                        <!-- CLOSE -->
                        <Button
                            Grid.Column="2"
                            Text="×"
                            FontSize="28"
                            FontAttributes="None"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppTextMuted}"
                            VerticalOptions="Start"
                            Clicked="OnSidebarCloseClicked" />

                    </Grid>


                    

                    


                    <!-- ================= MENU ================= -->

                    <ScrollView
                        Grid.Row="2"
                        VerticalOptions="Start">

                        <VerticalStackLayout Spacing="0">

                            <!-- GIRIS -->
<Grid
                        x:Name="AuthMenuRow"
                                                Padding="7,15"
                        ColumnDefinitions="28,*"
                        ColumnSpacing="8">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuthMenuTapped" />
                        </Grid.GestureRecognizers>

                        <Label
                            Grid.Column="0"
                            Text="&#xf2f6;"
                            FontFamily="FontAwesomeSolid"
                            FontSize="18"
                            TextColor="{DynamicResource AppAccent}"
                            VerticalTextAlignment="Center" />

                        <Label
                            x:Name="AuthUserLabel"
                            Grid.Column="1"
                            Text="Giriş Yap"
                            FontSize="15"
                            TextColor="{DynamicResource AppAccent}"
                            VerticalTextAlignment="Center" />

                    </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />



                            <!-- HESAPLAMA ARACI -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnCalculationMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf1ec;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hesaplama Aracı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- SUBELER -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchesMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf54e;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Şubelerimiz"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- HAKKIMIZDA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAboutMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf05a;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hakkımızda"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- YASAL -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLegalMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf3ed;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Yasal Uyarı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- BILDIRIM -->
                            <Grid
                                x:Name="NotificationMenuRow"
                                IsVisible="False"
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnNotificationMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf0f3;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Bildirim gönder"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- AYARLAR -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSettingsMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf013;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Ayarlar"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />

                        </VerticalStackLayout>

                    </ScrollView>


                    <!-- ================= FOOTER ================= -->

                    <VerticalStackLayout
                        Grid.Row="3"
                        Spacing="11">


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0e0;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="destek@mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0ac;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <!-- SOCIAL BUTTONS -->
                        <Grid
                            Margin="0,5,0,0"
                            ColumnDefinitions="46,46,46,*"
                            ColumnSpacing="10">


                            <Border
                                Grid.Column="0"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf095;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="17"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="1"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf16d;"
                                    FontFamily="FontAwesome6Brands-Regular"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="2"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf232;"
                                    FontFamily="FontAwesome6Brands-Regular"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <!-- LOGOUT -->
                            <Border
                                x:Name="LogoutMenuRow"
                                IsVisible="False"
                                Grid.Column="3"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1"
                                HorizontalOptions="End"
                                Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf2f5;"
                                        FontFamily="FontAwesomeSolid"
                                        FontSize="17"
                                        TextColor="{DynamicResource AppAccent}" />

                                    <Label
                                        Text="Çıkış"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource AppAccent}"
                                        VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </Grid>
        <!-- /MAZLUM SIDEBAR -->

</Grid>

</ContentPage>
