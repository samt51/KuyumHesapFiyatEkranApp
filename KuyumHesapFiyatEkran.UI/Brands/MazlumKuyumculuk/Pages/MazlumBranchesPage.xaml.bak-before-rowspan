<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumBranchesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#101113"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="18,12,18,14"
            ColumnDefinitions="42,42,*,42"
            ColumnSpacing="8">

            <Border
                Grid.Column="0"
                WidthRequest="36"
                HeightRequest="36"
                BackgroundColor="Transparent"
                StrokeThickness="0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped"/>
                </Border.GestureRecognizers>

                <Label
                    Text="☰"
                    TextColor="#C9AE20"
                    FontSize="24"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    InputTransparent="True"/>
            </Border>

            <Border
                Grid.Column="1"
                WidthRequest="36"
                HeightRequest="36"
                BackgroundColor="#181812"
                Stroke="#37331A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Border.GestureRecognizers>
                <Label
                    Text="‹"
                    TextColor="#C9AE20"
                    FontSize="28"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </Border>

            <Label
                Grid.Column="2"
                Text="Şubelerimiz"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"/>

            <Border
                x:Name="AddButton"
                Grid.Column="3"
                WidthRequest="36"
                HeightRequest="36"
                BackgroundColor="#181812"
                Stroke="#37331A"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 10"
                IsVisible="False">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddTapped"/>
                </Border.GestureRecognizers>

                <Label
                    Text="+"
                    TextColor="#C9AE20"
                    FontSize="25"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="18,8,18,30"
                Spacing="16">

                <Label
                    x:Name="ErrorLabel"
                    IsVisible="False"
                    TextColor="#E57373"
                    FontSize="13"/>

                <!-- ADMIN FORM -->
                <VerticalStackLayout
                    x:Name="BranchForm"
                    IsVisible="False"
                    Spacing="10">

                    <Label
                        Text="ŞUBE ADI"
                        TextColor="#929292"
                        FontSize="11"
                        CharacterSpacing="1.3"/>

                    <Border
                        BackgroundColor="#181812"
                        Stroke="#39351E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,4">

                        <Entry
                            x:Name="NameEntry"
                            Placeholder="Örn. Merkez Şube"
                            PlaceholderColor="#777777"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            HeightRequest="48"/>
                    </Border>

                    <Label
                        Margin="0,6,0,0"
                        Text="TELEFON"
                        TextColor="#929292"
                        FontSize="11"
                        CharacterSpacing="1.3"/>

                    <Border
                        BackgroundColor="#181812"
                        Stroke="#39351E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,4">

                        <Entry
                            x:Name="PhoneEntry"
                            Placeholder="0555 123 45 67"
                            PlaceholderColor="#777777"
                            TextColor="White"
                            Keyboard="Telephone"
                            BackgroundColor="Transparent"
                            HeightRequest="48"/>
                    </Border>

                    <Label
                        Margin="0,6,0,0"
                        Text="ADRES"
                        TextColor="#929292"
                        FontSize="11"
                        CharacterSpacing="1.3"/>

                    <Border
                        BackgroundColor="#181812"
                        Stroke="#39351E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,8">

                        <Editor
                            x:Name="AddressEditor"
                            Placeholder="Mahalle, cadde, ilçe..."
                            PlaceholderColor="#777777"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="90"/>
                    </Border>

                    <!-- 16:10 IMAGE -->
                    <Border
                        Margin="0,8,0,0"
                        HeightRequest="200"
                        BackgroundColor="#181812"
                        Stroke="#39351E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <Grid>
                            <Image
                                x:Name="BranchImage"
                                IsVisible="False"
                                Aspect="AspectFill"/>

                            <Label
                                x:Name="ImagePlaceholder"
                                Text="Şube görseli (16:10)"
                                TextColor="#929292"
                                FontSize="13"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout
                        Spacing="18">

                        <Label
                            Text="Çek"
                            TextColor="#C9AE20"
                            FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTakePhotoTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Label
                            Text="Galeri"
                            TextColor="#C9AE20"
                            FontSize="14">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGalleryTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <Label
                            x:Name="RemoveImageButton"
                            Text="Kaldır"
                            TextColor="#C9AE20"
                            FontSize="14"
                            IsVisible="False">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRemoveImageTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Button
                        x:Name="SaveButton"
                        Margin="0,10,0,0"
                        HeightRequest="52"
                        Text="Kaydet"
                        FontAttributes="Bold"
                        FontSize="15"
                        TextColor="#101113"
                        BackgroundColor="#C9AE20"
                        CornerRadius="11"
                        Clicked="OnSaveClicked"/>

                    <Button
                        Text="Vazgeç"
                        HeightRequest="42"
                        TextColor="#C9AE20"
                        BackgroundColor="Transparent"
                        Clicked="OnCancelClicked"/>
                </VerticalStackLayout>

                <!-- EMPTY -->
                <Label
                    x:Name="EmptyLabel"
                    Text="Henüz şube yok. + ile ekleyebilirsiniz."
                    TextColor="#8D8D8D"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    Margin="0,12,0,0"
                    IsVisible="False"/>

                <!-- LIST -->
                <VerticalStackLayout
                    x:Name="BranchesContainer"
                    Spacing="14"/>

                <ActivityIndicator
                    x:Name="LoadingIndicator"
                    Color="#C9AE20"
                    IsRunning="False"
                    IsVisible="False"
                    HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===================================================== -->
        <!-- BRANCHES SIDEBAR -->
        <!-- ===================================================== -->

        <Grid
            x:Name="SidebarOverlay"
            IsVisible="False"
            BackgroundColor="#99000000"
            ZIndex="100">

            <!-- KARARTMA -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>

            <!-- SOL PANEL -->
            <Border
                x:Name="SidebarPanel"
                WidthRequest="330"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                BackgroundColor="#171819"
                Stroke="#292A2B"
                StrokeThickness="1"
                TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="22,32,18,18"
                    RowDefinitions="Auto,*"
                    RowSpacing="12">

                    <!-- HEADER -->
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="58,*,40"
                        ColumnSpacing="12">

                        <!-- LOGO -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            Stroke="#D4B56A"
                            StrokeThickness="2"
                            BackgroundColor="Transparent">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label
                                    Text="mk"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#D4B56A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Row="1"
                                    Text="ESTD 1998"
                                    FontSize="4"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="#D4B56A"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,0,0,7" />

                            </Grid>
                        </Border>

                        <!-- WORDMARK -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">

                            <Label
                                Text="mazlum"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#D4B56A" />

                            <Label
                                Text="KUYUMCULUK"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.6"
                                TextColor="#D4B56A" />

                        </VerticalStackLayout>

                        <!-- CLOSE -->
                        <Button
                            Grid.Column="2"
                            Text="×"
                            FontSize="28"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="#92979F"
                            Clicked="OnSidebarCloseClicked" />

                    </Grid>

                    <!-- MENU -->
                    <ScrollView Grid.Row="1">

                        <VerticalStackLayout Spacing="0">

                            <!-- GİRİŞ -->
                            <Grid
                                x:Name="BranchAuthMenuRow"
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchAuthMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf2f6;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    x:Name="BranchAuthUserLabel"
                                    Grid.Column="1"
                                    Text="Giriş Yap"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />

                            <!-- HESAPLAMA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchCalculationTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf1ec;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hesaplama Aracı"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />

                            <!-- ŞUBELER -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchCurrentPageTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf07b;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Şubelerimiz"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />

                            <!-- HAKKIMIZDA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf05a;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hakkımızda"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />

                            <!-- YASAL -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf3ed;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Yasal Uyarı"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                        </VerticalStackLayout>

                    </ScrollView>

                </Grid>

            </Border>

        </Grid>

    </Grid>
</ContentPage>
