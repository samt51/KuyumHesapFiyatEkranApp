using System.Globalization;
using KuyumHesapFiyatEkran.UI.Services.Firebase;
using KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Services;

namespace KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages;

public partial class MazlumHomePage : ContentPage
{
    private readonly IMazlumFirebaseService firebaseService;
    private readonly MazlumFavoritesService favoritesService;

    private List<MazlumFirebasePrice> allPrices = new();

    private bool loaded;

    private MazlumTab currentTab =
        MazlumTab.Home;

    public MazlumHomePage(
        IMazlumFirebaseService firebaseService,
        MazlumFavoritesService favoritesService)
    {
        InitializeComponent();

        this.firebaseService = firebaseService;
        this.favoritesService = favoritesService;
    }

    protected override async void OnAppearing()
    {
        base.OnAppearing();

        if (loaded)
        {
            ShowCurrentTab();
            return;
        }

        loaded = true;

        await LoadPricesAsync();
    }

    private async Task LoadPricesAsync()
    {
        try
        {
            var result =
                await firebaseService.GetRatesAsync();

            allPrices = result.Prices
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Name)
                .ToList();

            LastUpdateLabel.Text =
                string.IsNullOrWhiteSpace(result.LastUpdate)
                    ? "--:--"
                    : result.LastUpdate;

            LiveIndicator.Fill =
                result.IsKurLive
                    ? Color.FromArgb("#3DCF8E")
                    : Color.FromArgb("#EF6B6B");

            ShowCurrentTab();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(
                $"Mazlum Firebase load error: {ex}");

            LiveIndicator.Fill =
                Color.FromArgb("#EF6B6B");

            LastUpdateLabel.Text =
                "--:--";
        }
    }

    private void ShowCurrentTab()
    {
        var favoriteIds =
            favoritesService.GetIds();
        IEnumerable<MazlumFirebasePrice> source =
            currentTab switch
            {
                MazlumTab.Home =>
                    allPrices.Where(
                        x => string.Equals(
                            x.List,
                            "home",
                            StringComparison.OrdinalIgnoreCase)),

                MazlumTab.Other =>
                    allPrices.Where(
                        x => string.Equals(
                            x.List,
                            "other",
                            StringComparison.OrdinalIgnoreCase)),

                MazlumTab.Favorites =>
                    allPrices.Where(
                        x => favoriteIds.Contains(x.Id)),

                _ => allPrices
            };

        var rows =
            source
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Name)
                .Select(CreateRow)
                .ToList();
        PricesCollection.ItemsSource =
            rows;

        if (rows.Count == 0)
        {
            EmptyStateLabel.Text =
                currentTab == MazlumTab.Favorites
                    ? "Henüz favori yok. Ürüne girip yıldıza dokunun."
                    : "Gösterilecek ürün yok.";

            EmptyStateSpinner.IsRunning =
                false;

            EmptyStateSpinner.IsVisible =
                false;
        }
        else
        {
            EmptyStateSpinner.IsRunning =
                false;

            EmptyStateSpinner.IsVisible =
                false;
        }

        UpdateTabAppearance();
    }

    private void UpdateTabAppearance()
    {
        var active =
            Color.FromArgb("#D4B56A");

        var inactive =
            Color.FromArgb("#777C84");

        FavoritesIcon.TextColor =
            currentTab == MazlumTab.Favorites
                ? active
                : inactive;

        FavoritesLabel.TextColor =
            currentTab == MazlumTab.Favorites
                ? active
                : inactive;

        FavoritesIcon.Text =
            currentTab == MazlumTab.Favorites
                ? "★"
                : "☆";

        HomeIcon.TextColor =
            currentTab == MazlumTab.Home
                ? active
                : inactive;

        HomeLabel.TextColor =
            currentTab == MazlumTab.Home
                ? active
                : inactive;

        OtherIcon.TextColor =
            currentTab == MazlumTab.Other
                ? active
                : inactive;

        OtherLabel.TextColor =
            currentTab == MazlumTab.Other
                ? active
                : inactive;
    }

    private void OnFavoritesTapped(
        object sender,
        TappedEventArgs e)
    {
        currentTab =
            MazlumTab.Favorites;

        ShowCurrentTab();
    }

    private void OnHomeTapped(
        object sender,
        TappedEventArgs e)
    {
        currentTab =
            MazlumTab.Home;

        ShowCurrentTab();
    }

    private void OnOtherTapped(
        object sender,
        TappedEventArgs e)
    {
        currentTab =
            MazlumTab.Other;

        ShowCurrentTab();
    }

    private static MazlumPriceRow CreateRow(
        MazlumFirebasePrice item)
    {
        return new MazlumPriceRow
        {
            Id = item.Id,
            Source = item,
            Name = item.Name,

            Buy =
                FormatPrice(
                    item.Buy,
                    item.Unit),

            Sell =
                FormatPrice(
                    item.Sell,
                    item.Unit),

            BuyChangeDisplay =
                FormatChange(
                    item.BuyChangePercent),

            SellChangeDisplay =
                FormatChange(
                    item.SellChangePercent),

            BuyChangeColor =
                GetChangeColor(
                    item.BuyChangePercent),

            SellChangeColor =
                GetChangeColor(
                    item.SellChangePercent)
        };
    }

    private static string FormatPrice(
        decimal value,
        string unit)
    {
        var culture =
            CultureInfo.GetCultureInfo(
                "tr-TR");

        var formatted =
            value.ToString(
                "#,##0.##",
                culture);

        return string.IsNullOrWhiteSpace(unit)
            ? formatted
            : $"{formatted} {unit}";
    }

    private static string FormatChange(
        decimal? value)
    {
        if (!value.HasValue)
            return string.Empty;

        var prefix =
            value.Value > 0
                ? "▲ "
                : value.Value < 0
                    ? "▼ "
                    : string.Empty;

        return
            prefix +
            value.Value.ToString(
                "0.##",
                CultureInfo.InvariantCulture) +
            "%";
    }

    private static Color GetChangeColor(
        decimal? value)
    {
        if (!value.HasValue ||
            value.Value == 0)
        {
            return Color.FromArgb(
                "#777C84");
        }

        return value.Value > 0
            ? Color.FromArgb("#3DCF8E")
            : Color.FromArgb("#EF6B6B");
    }

    private void OnMenuClicked(
        object sender,
        EventArgs e)
    {
        Shell.Current.FlyoutIsPresented =
            true;
    }

    private enum MazlumTab
    {
        Favorites,
        Home,
        Other
    }

    private async void OnPriceSelected(
        object sender,
        SelectionChangedEventArgs e)
    {
        if (e.CurrentSelection.FirstOrDefault()
            is not MazlumPriceRow row)
        {
            return;
        }

        if (sender is CollectionView collectionView)
        {
            collectionView.SelectedItem = null;
        }

        await Navigation.PushAsync(
            new MazlumDetailPage(
                row.Source,
                favoritesService));
    }

    private sealed class MazlumPriceRow
    {
        public string Id { get; init; } =
            string.Empty;

        public MazlumFirebasePrice Source { get; init; } =
            null!;

        public string Name { get; init; } =
            string.Empty;

        public string Buy { get; init; } =
            string.Empty;

        public string Sell { get; init; } =
            string.Empty;

        public string BuyChangeDisplay { get; init; } =
            string.Empty;

        public string SellChangeDisplay { get; init; } =
            string.Empty;

        public Color BuyChangeColor { get; init; } =
            Colors.Transparent;

        public Color SellChangeColor { get; init; } =
            Colors.Transparent;
    }
}
