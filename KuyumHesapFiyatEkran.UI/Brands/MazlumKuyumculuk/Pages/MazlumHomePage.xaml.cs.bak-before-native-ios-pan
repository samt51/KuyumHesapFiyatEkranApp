    private void UpdateAuthUi()
    {
        var isAuthenticated =
            authService.IsAuthenticated &&
            !string.IsNullOrWhiteSpace(authService.UserEmail);

        var email = authService.UserEmail?.Trim();

        AuthUserLabel.Text =
            isAuthenticated
                ? email
                : "Giriş Yap";

        LogoutMenuRow.IsVisible = isAuthenticated;

        var isAdmin =
            isAuthenticated &&
            string.Equals(
                email,
                "admin@mazlumkuyumculuk.com",
                StringComparison.OrdinalIgnoreCase);

        NotificationMenuRow.IsVisible = isAdmin;
    }

