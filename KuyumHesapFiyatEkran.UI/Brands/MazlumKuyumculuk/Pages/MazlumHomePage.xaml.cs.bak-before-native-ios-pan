    private static MazlumPriceRow CreateRow(
        MazlumFirebasePrice item)
    {
        return new MazlumPriceRow
        {
            Id = item.Id,
            Source = item,
            Name = item.Name,

            Buy =
                FormatPrice(
                    item.Buy,
                    item.Unit),

            Sell =
                FormatPrice(
                    item.Sell,
                    item.Unit),

            BuyChangeDisplay =
                FormatChange(
                    item.BuyChangePercent),

            SellChangeDisplay =
                FormatChange(
                    item.SellChangePercent),

            BuyChangeColor =
                GetChangeColor(
                    item.BuyChangePercent),

            SellChangeColor =
                GetChangeColor(
                    item.SellChangePercent)
        };
    }

    private static string FormatPrice(
        decimal value,
        string unit)
    {
        var culture =
            CultureInfo.GetCultureInfo(
                "tr-TR");

        var formatted =
            value.ToString(
                "#,##0",
                culture);

        return formatted;
    }

    private static string FormatChange(
        decimal? value)
    {
        if (!value.HasValue)
            return string.Empty;

        var prefix =
            value.Value > 0
                ? "▲ "
                : value.Value < 0
                    ? "▼ "
                    : string.Empty;

        return
            prefix +
            value.Value.ToString(
                "0.##",
                CultureInfo.InvariantCulture) +
            "%";
    }

    private static Color GetChangeColor(
        decimal? value)
    {
        if (!value.HasValue ||
            value.Value == 0)
        {
            return Color.FromArgb(
                "#777C84");
        }

        return value.Value > 0
            ? Color.FromArgb("#3DCF8E")
            : Color.FromArgb("#EF6B6B");
    }

