    protected override async void OnAppearing()
    {
        base.OnAppearing();

        await RestoreAuthSessionIfNeededAsync();
        UpdateAuthUi();

        if (loaded)
        {
            ShowCurrentTab();
            return;
        }

        loaded = true;

        await LoadPricesAsync();
    }

    private async Task LoadPricesAsync()
    {
        try
        {
            var result =
                await firebaseService.GetRatesAsync();

            allPrices = result.Prices
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Name)
                .ToList();

            LastUpdateLabel.Text =
                string.IsNullOrWhiteSpace(result.LastUpdate)
                    ? "--:--"
                    : result.LastUpdate;

            LiveIndicator.Fill =
                result.IsKurLive
                    ? Color.FromArgb("#3DCF8E")
                    : Color.FromArgb("#EF6B6B");

            ShowCurrentTab();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine(
                $"Mazlum Firebase load error: {ex}");

            LiveIndicator.Fill =
                Color.FromArgb("#EF6B6B");

            LastUpdateLabel.Text =
                "--:--";
        }
    }

    private void ShowCurrentTab()
    {
        var favoriteIds =
            favoritesService.GetIds();
        IEnumerable<MazlumFirebasePrice> source =
            currentTab switch
            {
                MazlumTab.Home =>
                    allPrices.Where(
                        x => string.Equals(
                            x.List,
                            "home",
                            StringComparison.OrdinalIgnoreCase)),

                MazlumTab.Other =>
                    allPrices.Where(
                        x => string.Equals(
                            x.List,
                            "other",
                            StringComparison.OrdinalIgnoreCase)),

                MazlumTab.Favorites =>
                    allPrices.Where(
                        x => favoriteIds.Contains(x.Id)),

                _ => allPrices
            };

        var rows =
            ApplyCustomPriceOrder(source)
                .Select(CreateRow)
                .ToList();

        visiblePriceRows.Clear();

        foreach (var row in rows)
        {
            visiblePriceRows.Add(row);
        }

        if (!ReferenceEquals(
                PricesCollection.ItemsSource,
                visiblePriceRows))
        {
            PricesCollection.ItemsSource =
                visiblePriceRows;
        }

        if (visiblePriceRows.Count == 0)
        {
            EmptyStateLabel.Text =
                currentTab == MazlumTab.Favorites
                    ? "Henüz favori yok. Ürüne girip yıldıza dokunun."
                    : "Gösterilecek ürün yok.";

            EmptyStateSpinner.IsRunning =
                false;

            EmptyStateSpinner.IsVisible =
                false;
        }
        else
        {
            EmptyStateSpinner.IsRunning =
                false;

            EmptyStateSpinner.IsVisible =
                false;
        }

        UpdateTabAppearance();
    }

