    private IEnumerable<MazlumFirebasePrice> ApplyCustomPriceOrder(
        IEnumerable<MazlumFirebasePrice> source)
    {
        var items =
            source
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Name)
                .ToList();

        var savedOrder =
            Preferences.Default.Get(
                PriceOrderPreferenceKey,
                string.Empty);

        if (string.IsNullOrWhiteSpace(savedOrder))
        {
            return items;
        }

        var ids =
            savedOrder
                .Split(
                    '|',
                    StringSplitOptions.RemoveEmptyEntries |
                    StringSplitOptions.TrimEntries)
                .ToList();

        if (ids.Count == 0)
        {
            return items;
        }

        var positions =
            ids
                .Select((id, index) => new { id, index })
                .GroupBy(x => x.id)
                .ToDictionary(
                    x => x.Key,
                    x => x.First().index,
                    StringComparer.OrdinalIgnoreCase);

        return items
            .OrderBy(
                x => positions.TryGetValue(
                    x.Id,
                    out var position)
                        ? position
                        : int.MaxValue)
            .ThenBy(x => x.Order)
            .ThenBy(x => x.Name)
            .ToList();
    }

    private void SaveCurrentPriceOrder(
        IReadOnlyList<MazlumFirebasePrice> prices)
    {
        var order =
            string.Join(
                "|",
                prices
                    .Where(x => !string.IsNullOrWhiteSpace(x.Id))
                    .Select(x => x.Id));

        Preferences.Default.Set(
            PriceOrderPreferenceKey,
            order);
    }

    private void OnPriceDragStarting(
        object sender,
        DragStartingEventArgs e)
    {
        if (sender is not DragGestureRecognizer dragGesture ||
            dragGesture.BindingContext is not MazlumPriceRow row)
        {
            e.Cancel = true;
            return;
        }

        draggedPriceId = row.Id;

        e.Data.Properties["MazlumPriceId"] =
            row.Id;
    }

    private void OnPriceDragOver(
        object sender,
        DragEventArgs e)
    {
        e.AcceptedOperation =
            DataPackageOperation.Copy;

        if (sender is not DropGestureRecognizer dropGesture)
        {
            return;
        }

        if (dropGesture.Parent is VisualElement target)
        {
            target.BackgroundColor =
                Color.FromArgb("#383112");
        }
    }

    private void OnPriceDragLeave(
        object sender,
        DragEventArgs e)
    {
        if (sender is not DropGestureRecognizer dropGesture)
        {
            return;
        }

        if (dropGesture.Parent is VisualElement target)
        {
            target.BackgroundColor =
                Colors.Transparent;
        }
    }

    private void OnPriceDropped(
        object sender,
        DropEventArgs e)
    {
        try
        {
            if (sender is DropGestureRecognizer highlightGesture &&
                highlightGesture.Parent is VisualElement highlightTarget)
            {
                highlightTarget.BackgroundColor =
                    Colors.Transparent;
            }

            if (sender is not DropGestureRecognizer dropGesture ||
                dropGesture.BindingContext is not MazlumPriceRow targetRow)
            {
                return;
            }

            var sourceId =
                draggedPriceId;

            if (string.IsNullOrWhiteSpace(sourceId) ||
                string.Equals(
                    sourceId,
                    targetRow.Id,
                    StringComparison.OrdinalIgnoreCase))
            {
                return;
            }

            var ordered =
                ApplyCustomPriceOrder(allPrices)
                    .ToList();

            var sourceIndex =
                ordered.FindIndex(
                    x => string.Equals(
                        x.Id,
                        sourceId,
                        StringComparison.OrdinalIgnoreCase));

            var targetIndex =
                ordered.FindIndex(
                    x => string.Equals(
                        x.Id,
                        targetRow.Id,
                        StringComparison.OrdinalIgnoreCase));

            if (sourceIndex < 0 ||
                targetIndex < 0)
            {
                return;
            }

            var moving =
                ordered[sourceIndex];

            ordered.RemoveAt(sourceIndex);

            targetIndex =
                ordered.FindIndex(
                    x => string.Equals(
                        x.Id,
                        targetRow.Id,
                        StringComparison.OrdinalIgnoreCase));

            if (targetIndex < 0)
            {
                return;
            }

            ordered.Insert(
                targetIndex,
                moving);

            SaveCurrentPriceOrder(ordered);

            ShowCurrentTab();
        }
        finally
        {
            draggedPriceId = null;
        }
    }

    private void OnPriceHandlePanUpdated(
        object sender,
        PanUpdatedEventArgs e)
    {
        var diagnostic =
            $"PAN {DateTime.Now:HH:mm:ss.fff} " +
            $"status={e.StatusType} " +
            $"y={e.TotalY:F1} " +
            $"sender={sender?.GetType().Name} " +
            $"context={(sender as PanGestureRecognizer)?.BindingContext?.GetType().Name ?? "NULL"} " +
            $"parent={(sender as PanGestureRecognizer)?.Parent?.GetType().Name ?? "NULL"}";

        System.Diagnostics.Debug.WriteLine(diagnostic);

        try
        {
            System.IO.File.AppendAllText(
                System.IO.Path.Combine(
                    FileSystem.AppDataDirectory,
                    "mazlum-pan-debug.txt"),
                diagnostic + Environment.NewLine);
        }
        catch
        {
            // Teshis logu uygulamanin calismasini etkilemesin.
        }

        if (sender is not PanGestureRecognizer panGesture ||
            panGesture.BindingContext is not MazlumPriceRow row)
        {
            return;
        }

        if (panGesture.Parent is not VisualElement handle)
        {
            return;
        }

        const double rowStep = 55d;

        switch (e.StatusType)
        {
            case GestureStatus.Started:
            {
                draggedPriceId = row.Id;
                lastPanY = 0;

                handle.Scale = 1.08;

                SetHandleColor(
                    handle,
                    Color.FromArgb("#D4B56A"));

                break;
            }

            case GestureStatus.Running:
            {
                if (string.IsNullOrWhiteSpace(draggedPriceId))
                {
                    return;
                }

                var currentIndex =
                    FindVisiblePriceIndex(
                        draggedPriceId);

                if (currentIndex < 0)
                {
                    return;
                }

                var delta =
                    e.TotalY - lastPanY;

                if (Math.Abs(delta) < rowStep)
                {
                    handle.TranslationY =
                        Math.Clamp(
                            delta,
                            -rowStep,
                            rowStep);

                    return;
                }

                var direction =
                    delta > 0
                        ? 1
                        : -1;

                var targetIndex =
                    currentIndex + direction;

                if (targetIndex < 0 ||
                    targetIndex >= visiblePriceRows.Count)
                {
                    handle.TranslationY = 0;
                    lastPanY = e.TotalY;
                    return;
                }

                visiblePriceRows.Move(
                    currentIndex,
                    targetIndex);

                lastPanY = e.TotalY;

                handle.TranslationY = 0;

                break;
            }

            case GestureStatus.Completed:
            case GestureStatus.Canceled:
            {
                handle.TranslationY = 0;
                handle.Scale = 1;

                SetHandleColor(
                    handle,
                    Color.FromArgb("#777C84"));

                SaveVisiblePriceOrder();

                draggedPriceId = null;
                lastPanY = 0;

                break;
            }
        }
    }

    private int FindVisiblePriceIndex(
        string id)
    {
        for (var i = 0;
             i < visiblePriceRows.Count;
             i++)
        {
            if (string.Equals(
                    visiblePriceRows[i].Id,
                    id,
                    StringComparison.OrdinalIgnoreCase))
            {
                return i;
            }
        }

        return -1;
    }

    private void SaveVisiblePriceOrder()
    {
        if (visiblePriceRows.Count == 0)
        {
            return;
        }

        var visibleIds =
            visiblePriceRows
                .Select(x => x.Id)
                .ToList();

        var completeOrder =
            ApplyCustomPriceOrder(allPrices)
                .ToList();

        var visibleIdSet =
            visibleIds.ToHashSet(
                StringComparer.OrdinalIgnoreCase);

        var positions =
            completeOrder
                .Select((item, index) =>
                    new
                    {
                        item.Id,
                        Index = index
                    })
                .Where(x =>
                    visibleIdSet.Contains(x.Id))
                .Select(x => x.Index)
                .OrderBy(x => x)
                .ToList();

        for (var i = 0;
             i < positions.Count &&
             i < visibleIds.Count;
             i++)
        {
            var id =
                visibleIds[i];

            var item =
                completeOrder.FirstOrDefault(
                    x => string.Equals(
                        x.Id,
                        id,
                        StringComparison.OrdinalIgnoreCase));

            if (item is not null)
            {
                completeOrder[positions[i]] =
                    item;
            }
        }

        allPrices =
            completeOrder;

        SaveCurrentPriceOrder(
            completeOrder);
    }

    private static void SetHandleColor(
        VisualElement handle,
        Color color)
    {
        if (handle is not Grid grid)
        {
            return;
        }

        var stack =
            grid.Children
                .OfType<VerticalStackLayout>()
                .FirstOrDefault();

        if (stack is null)
        {
            return;
        }

        foreach (var box in stack.Children.OfType<BoxView>())
        {
            box.Color = color;
        }
    }

    private void MovePriceToTarget(
        string sourceId,
        string targetId,
        bool placeAfterTarget)
    {
        if (string.Equals(
            sourceId,
            targetId,
            StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var ordered =
            ApplyCustomPriceOrder(allPrices)
                .ToList();

        var sourceIndex =
            ordered.FindIndex(
                x => string.Equals(
                    x.Id,
                    sourceId,
                    StringComparison.OrdinalIgnoreCase));

        var targetIndex =
            ordered.FindIndex(
                x => string.Equals(
                    x.Id,
                    targetId,
                    StringComparison.OrdinalIgnoreCase));

        if (sourceIndex < 0 ||
            targetIndex < 0)
        {
            return;
        }

        var moving =
            ordered[sourceIndex];

        ordered.RemoveAt(sourceIndex);

        targetIndex =
            ordered.FindIndex(
                x => string.Equals(
                    x.Id,
                    targetId,
                    StringComparison.OrdinalIgnoreCase));

        if (targetIndex < 0)
        {
            return;
        }

        if (placeAfterTarget)
        {
            targetIndex++;
        }

        targetIndex =
            Math.Clamp(
                targetIndex,
                0,
                ordered.Count);

        ordered.Insert(
            targetIndex,
            moving);

        SaveCurrentPriceOrder(ordered);

        // allPrices'i de yeni siraya al.
        // Boylece sonraki hareket ayni siradan devam eder.
        allPrices = ordered;

        ShowCurrentTab();
    }

