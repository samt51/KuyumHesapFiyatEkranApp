<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#101113">

    <Grid>

        <!-- MAIN CONTENT -->
        <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="10,50,10,22"
            ColumnDefinitions="32,62,Auto,*,Auto,Auto"
            ColumnSpacing="6"
            BackgroundColor="#101113">

            <!-- HAMBURGER -->
            <Button
                Grid.Column="0"
                Text="☰"
                FontSize="28"
                FontAttributes="Bold"
                WidthRequest="32"
                HeightRequest="62"
                Padding="0"
                Margin="-5,0,0,0"
                BackgroundColor="Transparent"
                TextColor="#D4B56A"
                VerticalOptions="Center"
                Clicked="OnMenuClicked" />

            <!-- MK LOGO -->
            <Border
                Grid.Column="1"
                WidthRequest="62"
                HeightRequest="62"
                Stroke="#D4B56A"
                StrokeThickness="2"
                BackgroundColor="Transparent"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="31" />
                </Border.StrokeShape>

                <Grid RowDefinitions="*,Auto">

                    <Label
                        Text="mk"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="#D4B56A"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,4,0,0" />

                    <Label
                        Grid.Row="1"
                        Text="ESTD 1998"
                        FontSize="5"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="#D4B56A"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,8" />

                </Grid>

            </Border>

            <!-- WORDMARK -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="0"
                VerticalOptions="Center"
                Margin="1,0,0,0">

                <Label
                    Text="mazlum"
                    FontSize="23"
                    FontAttributes="Bold"
                    TextColor="#D4B56A"
                    CharacterSpacing="-0.4"
                    LineBreakMode="NoWrap" />

                <Label
                    Text="KUYUMCULUK"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="1.25"
                    TextColor="#D4B56A"
                    Margin="0,1,0,0"
                    LineBreakMode="NoWrap" />

            </VerticalStackLayout>

            <!-- LIVE + CLOCK -->
            <HorizontalStackLayout
                Grid.Column="4"
                Spacing="4"
                VerticalOptions="Center"
                HorizontalOptions="End">

                <Ellipse
                    x:Name="LiveIndicator"
                    WidthRequest="8"
                    HeightRequest="8"
                    Fill="#3DCF8E"
                    VerticalOptions="Center" />

                <Label
                    x:Name="LastUpdateLabel"
                    Text="--:--"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="#92979F"
                    VerticalTextAlignment="Center"
                    LineBreakMode="NoWrap" />

            </HorizontalStackLayout>

            <!-- ACTION BUTTONS -->
            <HorizontalStackLayout
                Grid.Column="5"
                Spacing="5"
                VerticalOptions="Center"
                HorizontalOptions="End">

                <!-- THEME -->
                <Border
                    WidthRequest="40"
                    HeightRequest="40"
                    Stroke="#343426"
                    StrokeThickness="1"
                    BackgroundColor="#191A16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Label
                        Text="☼"
                        FontSize="22"
                        TextColor="#D4B56A"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />

                </Border>

                <!-- PLUS -->
                <Border
                    WidthRequest="40"
                    HeightRequest="40"
                    Stroke="#343426"
                    StrokeThickness="1"
                    BackgroundColor="#191A16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Label
                        Text="+"
                        FontSize="26"
                        TextColor="#D4B56A"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-2,0,0" />

                </Border>

            </HorizontalStackLayout>

        </Grid>

        <!-- PRICE LIST -->
        <Grid
            Grid.Row="1"
            Padding="18,0"
            RowDefinitions="Auto,*">

            <!-- COLUMN HEADERS -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="1.4*,*,*"
                Padding="2,10,2,10">

                <Label
                    Text="ÜRÜN"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="#777C84" />

                <Label
                    Grid.Column="1"
                    Text="ALIŞ"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="#777C84"
                    HorizontalTextAlignment="End" />

                <Label
                    Grid.Column="2"
                    Text="SATIŞ"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="#777C84"
                    HorizontalTextAlignment="End" />

            </Grid>

            <CollectionView
                x:Name="PricesCollection"
                Grid.Row="1"
                SelectionMode="Single"
                SelectionChanged="OnPriceSelected">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="20,50"
                        Spacing="10">

                        <ActivityIndicator
                            x:Name="EmptyStateSpinner"
                            IsRunning="True"
                            IsVisible="True"
                            Color="#D4B56A"
                            HorizontalOptions="Center" />

                        <Label
                            x:Name="EmptyStateLabel"
                            Text="Fiyatlar yükleniyor..."
                            FontSize="13"
                            TextColor="#777C84"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Grid RowDefinitions="Auto,1">

                            <Grid
                                Padding="2,17"
                                ColumnDefinitions="24,1.4*,*,*"
                                ColumnSpacing="6">

                                <!-- DRAG HANDLE -->
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    WidthRequest="24"
                                    Spacing="2"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">

                                    <BoxView
                                        WidthRequest="11"
                                        HeightRequest="2"
                                        CornerRadius="1"
                                        Color="#777C84"
                                        HorizontalOptions="Center" />

                                    <BoxView
                                        WidthRequest="11"
                                        HeightRequest="2"
                                        CornerRadius="1"
                                        Color="#777C84"
                                        HorizontalOptions="Center" />

                                    <BoxView
                                        WidthRequest="11"
                                        HeightRequest="2"
                                        CornerRadius="1"
                                        Color="#777C84"
                                        HorizontalOptions="Center" />

                                </VerticalStackLayout>

                                <!-- PRODUCT -->
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    FontSize="16"
                                    FontAttributes="None"
                                    TextColor="#F0F0F0"
                                    VerticalTextAlignment="Center"
                                    LineBreakMode="TailTruncation" />

                                <!-- BUY -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="2"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="{Binding Buy}"
                                        FontSize="19"
                                        TextColor="#E6E6E6"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Text="{Binding BuyChangeDisplay}"
                                        FontSize="11"
                                        TextColor="{Binding BuyChangeColor}"
                                        HorizontalTextAlignment="End" />

                                </VerticalStackLayout>

                                <!-- SELL -->
                                <VerticalStackLayout
                                    Grid.Column="3"
                                    Spacing="2"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="{Binding Sell}"
                                        FontSize="19"
                                        TextColor="#D4B56A"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Text="{Binding SellChangeDisplay}"
                                        FontSize="11"
                                        TextColor="{Binding SellChangeColor}"
                                        HorizontalTextAlignment="End" />

                                </VerticalStackLayout>

                            </Grid>

                            <BoxView
                                Grid.Row="1"
                                HeightRequest="1"
                                Color="#272A2F" />

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- BOTTOM NAV -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*"
            Padding="12,9,12,24"
            BackgroundColor="#121417">

            <!-- FAVORITES -->
            <Grid
                x:Name="FavoritesTab"
                Grid.Column="0"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnFavoritesTapped" />
                </Grid.GestureRecognizers>

                <Label
                    x:Name="FavoritesIcon"
                    Text="☆"
                    FontSize="24"
                    TextColor="#777C84"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="FavoritesLabel"
                    Grid.Row="1"
                    Text="Favoriler"
                    FontSize="10"
                    TextColor="#777C84"
                    HorizontalTextAlignment="Center" />

            </Grid>

            <!-- HOME -->
            <Grid
                x:Name="HomeTab"
                Grid.Column="1"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnHomeTapped" />
                </Grid.GestureRecognizers>

                <Label
                    x:Name="HomeIcon"
                    Text="⌂"
                    FontSize="24"
                    TextColor="#D4B56A"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="HomeLabel"
                    Grid.Row="1"
                    Text="Ana sayfa"
                    FontSize="10"
                    TextColor="#D4B56A"
                    HorizontalTextAlignment="Center" />

            </Grid>

            <!-- OTHER -->
            <Grid
                x:Name="OtherTab"
                Grid.Column="2"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnOtherTapped" />
                </Grid.GestureRecognizers>

                <Label
                    x:Name="OtherIcon"
                    Text="◎"
                    FontSize="24"
                    TextColor="#777C84"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="OtherLabel"
                    Grid.Row="1"
                    Text="Diğer"
                    FontSize="10"
                    TextColor="#777C84"
                    HorizontalTextAlignment="Center" />

            </Grid>

        </Grid>

        </Grid>
        <!-- /MAIN CONTENT -->


        <!-- ====================================================== -->
        <!-- MAZLUM SIDEBAR OVERLAY                                 -->
        <!-- ====================================================== -->

        <Grid
            x:Name="SidebarOverlay"
            IsVisible="False"
            BackgroundColor="#99000000"
            ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>


            <!-- LEFT PANEL -->
            <Border
                x:Name="SidebarPanel"
                WidthRequest="330"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                BackgroundColor="#171819"
                Stroke="#292A2B"
                StrokeThickness="1"
                TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="22,32,18,18"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="12"
                    VerticalOptions="Start">


                    <!-- ================= HEADER ================= -->

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="Auto,*,40"
                        ColumnSpacing="12">

                        <!-- MK LOGO -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            Stroke="#D4B56A"
                            StrokeThickness="2"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label
                                    Text="mk"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="#D4B56A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    Margin="0,4,0,0" />

                                <Label
                                    Grid.Row="1"
                                    Text="ESTD 1998"
                                    FontSize="4"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="#D4B56A"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,0,0,7" />

                            </Grid>

                        </Border>


                        <!-- WORDMARK -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">

                            <Label
                                Text="mazlum"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#D4B56A" />

                            <Label
                                Text="KUYUMCULUK"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.6"
                                TextColor="#D4B56A" />

                        </VerticalStackLayout>


                        <!-- CLOSE -->
                        <Button
                            Grid.Column="2"
                            Text="×"
                            FontSize="28"
                            FontAttributes="None"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="#92979F"
                            VerticalOptions="Start"
                            Clicked="OnSidebarCloseClicked" />

                    </Grid>


                    

                    


                    <!-- ================= MENU ================= -->

                    <ScrollView
                        Grid.Row="2"
                        VerticalOptions="Start">

                        <VerticalStackLayout Spacing="0">

                            <!-- GIRIS -->
<Grid
                        x:Name="AuthMenuRow"
                                                Padding="7,15"
                        ColumnDefinitions="28,*"
                        ColumnSpacing="8">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuthMenuTapped" />
                        </Grid.GestureRecognizers>

                        <Label
                            Grid.Column="0"
                            Text="&#xf2f6;"
                            FontFamily="FontAwesomeSolid"
                            FontSize="18"
                            TextColor="#D4B56A"
                            VerticalTextAlignment="Center" />

                        <Label
                            x:Name="AuthUserLabel"
                            Grid.Column="1"
                            Text="Giriş Yap"
                            FontSize="15"
                            TextColor="#D4B56A"
                            VerticalTextAlignment="Center" />

                    </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />



                            <!-- HESAPLAMA ARACI -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnCalculationMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf1ec;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hesaplama Aracı"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- SUBELER -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf07b;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Şubelerimiz"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- HAKKIMIZDA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf05a;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hakkımızda"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- YASAL -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf3ed;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Yasal Uyarı"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- BILDIRIM -->
                            <Grid
                                x:Name="NotificationMenuRow"
                                IsVisible="False"
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf0f3;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Bildirim gönder"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- AYARLAR -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf013;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Ayarlar"
                                    FontSize="15"
                                    TextColor="#D4B56A"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />

                        </VerticalStackLayout>

                    </ScrollView>


                    <!-- ================= FOOTER ================= -->

                    <VerticalStackLayout
                        Grid.Row="3"
                        Spacing="11">


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0e0;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="#92979F" />

                            <Label
                                Text="destek@mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="#92979F"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0ac;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="#92979F" />

                            <Label
                                Text="mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="#92979F"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <!-- SOCIAL BUTTONS -->
                        <Grid
                            Margin="0,5,0,0"
                            ColumnDefinitions="46,46,46,*"
                            ColumnSpacing="10">


                            <Border
                                Grid.Column="0"
                                HeightRequest="44"
                                BackgroundColor="#202117"
                                Stroke="#3A3925"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf095;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="17"
                                    TextColor="#D4B56A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="1"
                                HeightRequest="44"
                                BackgroundColor="#202117"
                                Stroke="#3A3925"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf16d;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="2"
                                HeightRequest="44"
                                BackgroundColor="#202117"
                                Stroke="#3A3925"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf232;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="#D4B56A"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <!-- LOGOUT -->
                            <Border
                                x:Name="LogoutMenuRow"
                                IsVisible="False"
                                Grid.Column="3"
                                HeightRequest="44"
                                BackgroundColor="#202117"
                                Stroke="#3A3925"
                                StrokeThickness="1"
                                HorizontalOptions="End"
                                Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf2f5;"
                                        FontFamily="FontAwesomeSolid"
                                        FontSize="17"
                                        TextColor="#D4B56A" />

                                    <Label
                                        Text="Çıkış"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="#D4B56A"
                                        VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </Grid>
        <!-- /MAZLUM SIDEBAR -->

    </Grid>

</ContentPage>
