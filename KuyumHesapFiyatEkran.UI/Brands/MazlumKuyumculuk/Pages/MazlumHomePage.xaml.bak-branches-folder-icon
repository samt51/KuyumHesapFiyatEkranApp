<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{DynamicResource AppBackground}">

    <Grid>

        <!-- MAIN CONTENT -->
        <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="10,50,10,22"
            ColumnDefinitions="32,62,Auto,*,Auto,Auto"
            ColumnSpacing="6"
            BackgroundColor="{DynamicResource AppBackground}">

            <!-- HAMBURGER -->
            <Button
                Grid.Column="0"
                Text="☰"
                FontSize="28"
                FontAttributes="Bold"
                WidthRequest="32"
                HeightRequest="62"
                Padding="0"
                Margin="-5,0,0,0"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource AppAccent}"
                VerticalOptions="Center"
                Clicked="OnMenuClicked" />

            <!-- MK LOGO -->
            <Border
                Grid.Column="1"
                WidthRequest="62"
                HeightRequest="62"
                Stroke="#D4B56A"
                StrokeThickness="2"
                BackgroundColor="Transparent"
                VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="31" />
                </Border.StrokeShape>

                <Grid RowDefinitions="*,Auto">

                    <Label
                        Text="mk"
                        FontSize="23"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppAccent}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,4,0,0" />

                    <Label
                        Grid.Row="1"
                        Text="ESTD 1998"
                        FontSize="5"
                        FontAttributes="Bold"
                        CharacterSpacing="1"
                        TextColor="{DynamicResource AppAccent}"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,8" />

                </Grid>

            </Border>

            <!-- WORDMARK -->
            <VerticalStackLayout
                Grid.Column="2"
                Spacing="0"
                VerticalOptions="Center"
                Margin="1,0,0,0">

                <Label
                    Text="mazlum"
                    FontSize="23"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource AppAccent}"
                    CharacterSpacing="-0.4"
                    LineBreakMode="NoWrap" />

                <Label
                    Text="KUYUMCULUK"
                    FontSize="10"
                    FontAttributes="Bold"
                    CharacterSpacing="1.25"
                    TextColor="{DynamicResource AppAccent}"
                    Margin="0,1,0,0"
                    LineBreakMode="NoWrap" />

            </VerticalStackLayout>

            <!-- LIVE + CLOCK -->
            <HorizontalStackLayout
                Grid.Column="4"
                Spacing="4"
                VerticalOptions="Center"
                HorizontalOptions="End">

                <Ellipse
                    x:Name="LiveIndicator"
                    WidthRequest="8"
                    HeightRequest="8"
                    Fill="#3DCF8E"
                    VerticalOptions="Center" />

                <Label
                    x:Name="LastUpdateLabel"
                    Text="--:--"
                    FontSize="16"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource AppTextMuted}"
                    VerticalTextAlignment="Center"
                    LineBreakMode="NoWrap" />

            </HorizontalStackLayout>

            <!-- ACTION BUTTONS -->
            <HorizontalStackLayout
                Grid.Column="5"
                Spacing="5"
                VerticalOptions="Center"
                HorizontalOptions="End">

                <!-- THEME -->
                <Border
                    x:Name="ThemeToggleButton"
                    WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{DynamicResource AppBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource AppCardBackground}">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnThemeTapped" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid
                        WidthRequest="22"
                        HeightRequest="22"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <GraphicsView
                            x:Name="ThemeSunIcon"
                            WidthRequest="20"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <GraphicsView
                            x:Name="ThemeMoonIcon"
                            WidthRequest="20"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                    </Grid>

                </Border>

                <!-- ADMIN PRODUCT ADD -->
                <Border
                    x:Name="AdminAddProductButton"
                    IsVisible="False"
                    WidthRequest="40"
                    HeightRequest="40"
                    Stroke="{DynamicResource AppBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource AppCardBackground}">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="OnAddProductTapped" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Label
                        Text="+"
                        FontSize="26"
                        TextColor="{DynamicResource AppAccent}"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center"
                        Margin="0,-2,0,0" />

                </Border>

            </HorizontalStackLayout>

        </Grid>

        <!-- PRICE LIST -->
        <Grid
            Grid.Row="1"
            Padding="18,0"
            RowDefinitions="Auto,*">

            <!-- COLUMN HEADERS -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="1.4*,*,*"
                Padding="2,10,2,10">

                <Label
                    Text="ÜRÜN"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="{DynamicResource AppTextInactive}" />

                <Label
                    Grid.Column="1"
                    Text="ALIŞ"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="{DynamicResource AppTextInactive}"
                    HorizontalTextAlignment="End" />

                <Label
                    Grid.Column="2"
                    Text="SATIŞ"
                    FontSize="10"
                    CharacterSpacing="1.5"
                    TextColor="{DynamicResource AppTextInactive}"
                    HorizontalTextAlignment="End" />

            </Grid>

            <CollectionView
                x:Name="PricesCollection"
                Grid.Row="1"
                SelectionMode="None"
                SelectionChanged="OnPriceSelected">

                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="20,50"
                        Spacing="10">

                        <ActivityIndicator
                            x:Name="EmptyStateSpinner"
                            IsRunning="True"
                            IsVisible="True"
                            Color="#D4B56A"
                            HorizontalOptions="Center" />

                        <Label
                            x:Name="EmptyStateLabel"
                            Text="Fiyatlar yükleniyor..."
                            FontSize="13"
                            TextColor="{DynamicResource AppTextInactive}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Grid RowDefinitions="Auto,1">

                            <Grid
                                x:Name="PriceRowGrid"
                                Padding="10,17,18,17"
                                ColumnSpacing="6">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        x:Name="DragHandleColumn"
                                        Width="0" />
                                    <ColumnDefinition Width="1.55*" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <!-- DRAG HANDLE -->
                                <Grid
                                    x:Name="DragHandle"
                                    StyleId="MazlumDragHandle"
                                    Grid.Column="0"
                                    WidthRequest="32"
                                    IsVisible="False"
                                    InputTransparent="True"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    BackgroundColor="Transparent"
                                    Loaded="OnDragHandleLoaded"
                                    Unloaded="OnDragHandleUnloaded">

                                    <VerticalStackLayout
                                        Spacing="2"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">

                                        <BoxView
                                            WidthRequest="11"
                                            HeightRequest="2"
                                            CornerRadius="1"
                                            Color="#777C84"
                                            HorizontalOptions="Center" />

                                        <BoxView
                                            WidthRequest="11"
                                            HeightRequest="2"
                                            CornerRadius="1"
                                            Color="#777C84"
                                            HorizontalOptions="Center" />

                                        <BoxView
                                            WidthRequest="11"
                                            HeightRequest="2"
                                            CornerRadius="1"
                                            Color="#777C84"
                                            HorizontalOptions="Center" />

                                    </VerticalStackLayout>

                                </Grid>

                                <!-- PRODUCT -->
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Name}"
                                    FontSize="16"
                                    FontAttributes="None"
                                    TextColor="{DynamicResource AppTextPrimary}"
                                    VerticalTextAlignment="Center"
                                    LineBreakMode="TailTruncation" />

                                <!-- BUY -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="2"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="{Binding Buy}"
                                        FontSize="19"
                                        TextColor="{DynamicResource AppTextPrimary}"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Text="{Binding BuyChangeDisplay}"
                                        FontSize="11"
                                        TextColor="{Binding BuyChangeColor}"
                                        HorizontalTextAlignment="End" />

                                </VerticalStackLayout>

                                <!-- SELL -->
                                <VerticalStackLayout
                                    Grid.Column="3"
                                    Spacing="2"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="{Binding Sell}"
                                        FontSize="19"
                                        TextColor="{DynamicResource AppAccent}"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Text="{Binding SellChangeDisplay}"
                                        FontSize="11"
                                        TextColor="{Binding SellChangeColor}"
                                        HorizontalTextAlignment="End" />

                                </VerticalStackLayout>

                            </Grid>

                            <BoxView
                                Grid.Row="1"
                                HeightRequest="1"
                                Color="#272A2F" />

                        </Grid>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <!-- BOTTOM NAV -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*"
            Padding="12,9,12,24"
            BackgroundColor="{DynamicResource AppPanelBackground}">

            <!-- FAVORITES -->
            <Grid
                x:Name="FavoritesTab"
                Grid.Column="0"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnFavoritesTapped" />
                </Grid.GestureRecognizers>

                <Label
                    x:Name="FavoritesIcon"
                    Text="☆"
                    FontSize="24"
                    TextColor="{DynamicResource AppTextInactive}"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="FavoritesLabel"
                    Grid.Row="1"
                    Text="Favoriler"
                    FontSize="10"
                    TextColor="{DynamicResource AppTextInactive}"
                    HorizontalTextAlignment="Center" />

            </Grid>

            <!-- HOME -->
            <Grid
                x:Name="HomeTab"
                Grid.Column="1"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnHomeTapped" />
                </Grid.GestureRecognizers>

                <Label
                    x:Name="HomeIcon"
                    Text="⌂"
                    FontSize="24"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="HomeLabel"
                    Grid.Row="1"
                    Text="Ana sayfa"
                    FontSize="10"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center" />

            </Grid>

            <!-- OTHER -->
            <Grid
                x:Name="OtherTab"
                Grid.Column="2"
                RowDefinitions="Auto,Auto"
                RowSpacing="2">

                <Grid.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnOtherTapped" />
                </Grid.GestureRecognizers>

                <Label
                    x:Name="OtherIcon"
                    Text="◎"
                    FontSize="24"
                    TextColor="{DynamicResource AppTextInactive}"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="OtherLabel"
                    Grid.Row="1"
                    Text="Diğer"
                    FontSize="10"
                    TextColor="{DynamicResource AppTextInactive}"
                    HorizontalTextAlignment="Center" />

            </Grid>

        </Grid>

        </Grid>
        <!-- /MAIN CONTENT -->


        <!-- ====================================================== -->
        <!-- MAZLUM SIDEBAR OVERLAY                                 -->
        <!-- ====================================================== -->

        <Grid
            x:Name="SidebarOverlay"
            IsVisible="False"
            BackgroundColor="#99000000"
            ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>


            <!-- LEFT PANEL -->
            <Border
                x:Name="SidebarPanel"
                WidthRequest="330"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1"
                TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="22,32,18,22"
                    RowDefinitions="Auto,Auto,*,Auto"
                    RowSpacing="12"
                    VerticalOptions="Fill">


                    <!-- ================= HEADER ================= -->

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="Auto,*,40"
                        ColumnSpacing="12">

                        <!-- MK LOGO -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            Stroke="#D4B56A"
                            StrokeThickness="2"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label
                                    Text="mk"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    Margin="0,4,0,0" />

                                <Label
                                    Grid.Row="1"
                                    Text="ESTD 1998"
                                    FontSize="4"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,0,0,7" />

                            </Grid>

                        </Border>


                        <!-- WORDMARK -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">

                            <Label
                                Text="mazlum"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource AppAccent}" />

                            <Label
                                Text="KUYUMCULUK"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.6"
                                TextColor="{DynamicResource AppAccent}" />

                        </VerticalStackLayout>


                        <!-- CLOSE -->
                        <Button
                            Grid.Column="2"
                            Text="×"
                            FontSize="28"
                            FontAttributes="None"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppTextMuted}"
                            VerticalOptions="Start"
                            Clicked="OnSidebarCloseClicked" />

                    </Grid>


                    

                    


                    <!-- ================= MENU ================= -->

                    <ScrollView
                        Grid.Row="2"
                        VerticalOptions="Start">

                        <VerticalStackLayout Spacing="0">

                            <!-- GIRIS -->
<Grid
                        x:Name="AuthMenuRow"
                                                Padding="7,15"
                        ColumnDefinitions="28,*"
                        ColumnSpacing="8">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuthMenuTapped" />
                        </Grid.GestureRecognizers>

                        <Label
                            Grid.Column="0"
                            Text="&#xf2f6;"
                            FontFamily="FontAwesomeSolid"
                            FontSize="18"
                            TextColor="{DynamicResource AppAccent}"
                            VerticalTextAlignment="Center" />

                        <Label
                            x:Name="AuthUserLabel"
                            Grid.Column="1"
                            Text="Giriş Yap"
                            FontSize="15"
                            TextColor="{DynamicResource AppAccent}"
                            VerticalTextAlignment="Center" />

                    </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />



                            <!-- HESAPLAMA ARACI -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnCalculationMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf1ec;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hesaplama Aracı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- SUBELER -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchesMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf07b;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Şubelerimiz"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- HAKKIMIZDA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAboutMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf05a;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hakkımızda"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- YASAL -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLegalMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf3ed;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Yasal Uyarı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- BILDIRIM -->
                            <Grid
                                x:Name="NotificationMenuRow"
                                IsVisible="False"
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnNotificationMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf0f3;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Bildirim gönder"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />


                            <!-- AYARLAR -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSettingsMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf013;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Ayarlar"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="#303133" />

                        </VerticalStackLayout>

                    </ScrollView>


                    <!-- ================= FOOTER ================= -->

                    <VerticalStackLayout
                        Grid.Row="3"
                        Spacing="11">


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0e0;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="destek@mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0ac;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <!-- SOCIAL BUTTONS -->
                        <Grid
                            Margin="0,5,0,0"
                            ColumnDefinitions="46,46,46,*"
                            ColumnSpacing="10">


                            <Border
                                Grid.Column="0"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppCardBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <GraphicsView
                                    x:Name="PhoneSocialIcon"
                                    WidthRequest="19"
                                    HeightRequest="19"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>


                            <Border
                                Grid.Column="1"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppCardBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <GraphicsView
                                    x:Name="InstagramSocialIcon"
                                    WidthRequest="19"
                                    HeightRequest="19"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>


                            <Border
                                Grid.Column="2"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppCardBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <GraphicsView
                                    x:Name="WhatsAppSocialIcon"
                                    WidthRequest="19"
                                    HeightRequest="19"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>


                            <!-- LOGOUT -->
                            <Border
                                x:Name="LogoutMenuRow"
                                IsVisible="False"
                                Grid.Column="3"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppCardBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1"
                                HorizontalOptions="End"
                                Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf2f5;"
                                        FontFamily="FontAwesomeSolid"
                                        FontSize="17"
                                        TextColor="{DynamicResource AppAccent}" />

                                    <Label
                                        Text="Çıkış"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource AppAccent}"
                                        VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </Grid>
        <!-- /MAZLUM SIDEBAR -->

    </Grid>

</ContentPage>
