<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumCalculationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0B0C0C"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="18,52,18,16"
            ColumnDefinitions="40,40,*,40"
            ColumnSpacing="8"
            BackgroundColor="#101110">

            <Button
                Grid.Column="0"
                Text="☰"
                FontSize="22"
                TextColor="#D4B56A"
                BackgroundColor="Transparent"
                Padding="0"
                Clicked="OnMenuClicked" />

            <Border
                Grid.Column="1"
                WidthRequest="34"
                HeightRequest="34"
                Stroke="#40391E"
                StrokeThickness="1"
                BackgroundColor="#18180F">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>

                <Label
                    Text="‹"
                    FontSize="27"
                    TextColor="#D4B56A"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    Margin="0,-3,0,0" />

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Label
                Grid.Column="2"
                Text="Hesaplama"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#F1F1ED"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="18,16,18,20"
                Spacing="12">

                <Label
                    Text="ÜRÜN"
                    FontSize="11"
                    CharacterSpacing="1"
                    TextColor="#777A77" />

                <Border
                    HeightRequest="54"
                    Stroke="#39351C"
                    StrokeThickness="1"
                    BackgroundColor="#17170F">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Picker
                        x:Name="ProductPicker"
                        Title="Ürün seçiniz"
                        FontSize="16"
                        TextColor="#F2F2ED"
                        TitleColor="#8D8D87"
                        Margin="8,0"
                        SelectedIndexChanged="OnProductChanged" />
                </Border>

                <Label
                    Margin="0,6,0,0"
                    Text="MİKTAR (GRAM / ADET)"
                    FontSize="11"
                    CharacterSpacing="1"
                    TextColor="#777A77" />

                <Grid ColumnDefinitions="*,52" ColumnSpacing="8">

                    <Border
                        Grid.Column="0"
                        HeightRequest="52"
                        Stroke="#39351C"
                        StrokeThickness="1"
                        BackgroundColor="#17170F">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="AmountEntry"
                            Placeholder="0"
                            PlaceholderColor="#777A77"
                            TextColor="#F2F2ED"
                            FontSize="16"
                            Keyboard="Numeric"
                            HorizontalTextAlignment="End"
                            Margin="12,0" />
                    </Border>

                    <Button
                        Grid.Column="1"
                        Text="+"
                        FontSize="23"
                        TextColor="#D4B56A"
                        BackgroundColor="#17170F"
                        BorderColor="#39351C"
                        BorderWidth="1"
                        CornerRadius="12"
                        Padding="0"
                        Clicked="OnAddClicked" />

                </Grid>

                <BoxView
                    Margin="0,4,0,0"
                    HeightRequest="1"
                    Color="#242525" />

                <!-- TABLE HEADER -->
                <Grid
                    Padding="0,2"
                    ColumnDefinitions="1.7*,.8*,1*,1*"
                    ColumnSpacing="6">

                    <Label
                        Text="ÜRÜN"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="#777A77" />

                    <Label
                        Grid.Column="1"
                        Text="MİKTAR"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="#777A77"
                        HorizontalTextAlignment="End" />

                    <Label
                        Grid.Column="2"
                        Text="ALIŞ"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="#777A77"
                        HorizontalTextAlignment="End" />

                    <Label
                        Grid.Column="3"
                        Text="SATIŞ"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="#777A77"
                        HorizontalTextAlignment="End" />

                </Grid>

                <VerticalStackLayout
                    x:Name="RowsContainer"
                    Spacing="0">

                    <Label
                        x:Name="EmptyRowsLabel"
                        Text="Henüz satır yok. Ürün ve miktar ekleyin."
                        FontSize="12"
                        TextColor="#777A77"
                        Margin="0,2,0,6" />

                </VerticalStackLayout>

                <BoxView
                    HeightRequest="1"
                    Color="#242525" />

                <!-- TOTAL -->
                <Grid
                    Padding="0,5"
                    ColumnDefinitions="1.7*,.8*,1*,1*"
                    ColumnSpacing="6">

                    <Label
                        Text="Toplam"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#F1F1ED" />

                    <Label
                        x:Name="TotalBuyLabel"
                        Grid.Column="2"
                        Text="0,00"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#D4B56A"
                        HorizontalTextAlignment="End" />

                    <Label
                        x:Name="TotalSellLabel"
                        Grid.Column="3"
                        Text="0,00"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#D4B56A"
                        HorizontalTextAlignment="End" />

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DISCLAIMER -->
        <Grid
            Grid.Row="2"
            Padding="18,10,18,22"
            BackgroundColor="#0B0C0C">

            <VerticalStackLayout Spacing="10">

                <BoxView
                    HeightRequest="1"
                    Color="#242525" />

                <Label
                    Text="Bu ekrandaki hesaplama ve fiyatlar bağlayıcı değildir. Yasal yükümlülük oluşturmaz."
                    FontSize="10"
                    TextColor="#777A77"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
