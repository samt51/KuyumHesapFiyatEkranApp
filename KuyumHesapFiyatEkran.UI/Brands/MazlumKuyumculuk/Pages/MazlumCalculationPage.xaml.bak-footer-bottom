<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumCalculationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource AppBackground}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="18,52,18,16"
            ColumnDefinitions="40,40,*,40"
            ColumnSpacing="8"
            BackgroundColor="{DynamicResource AppBackground}">

            <Button
                Grid.Column="0"
                Text="☰"
                FontSize="22"
                TextColor="{DynamicResource AppAccent}"
                BackgroundColor="Transparent"
                Padding="0"
                Clicked="OnMenuClicked" />

            <Border
                Grid.Column="1"
                WidthRequest="34"
                HeightRequest="34"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1"
                BackgroundColor="{DynamicResource AppCardBackground}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="9" />
                </Border.StrokeShape>

                <Label
                    Text="‹"
                    FontSize="27"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    Margin="0,-3,0,0" />

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
            </Border>

            <Label
                Grid.Column="2"
                Text="Hesaplama"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="{DynamicResource AppTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

        </Grid>

        <!-- CONTENT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="18,16,18,20"
                Spacing="12">

                <Label
                    Text="ÜRÜN"
                    FontSize="11"
                    CharacterSpacing="1"
                    TextColor="{DynamicResource AppTextInactive}" />

                <Border
                    HeightRequest="54"
                    Stroke="{DynamicResource AppBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource AppCardBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Picker
                        x:Name="ProductPicker"
                        Title="Ürün seçiniz"
                        FontSize="16"
                        TextColor="{DynamicResource AppTextPrimary}"
                        TitleColor="{DynamicResource AppTextMuted}"
                        Margin="8,0"
                        SelectedIndexChanged="OnProductChanged" />
                </Border>

                <Label
                    Margin="0,6,0,0"
                    Text="MİKTAR (GRAM / ADET)"
                    FontSize="11"
                    CharacterSpacing="1"
                    TextColor="{DynamicResource AppTextInactive}" />

                <Grid ColumnDefinitions="*,52" ColumnSpacing="8">

                    <Border
                        Grid.Column="0"
                        HeightRequest="52"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppCardBackground}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Entry
                            x:Name="AmountEntry"
                            Placeholder="0"
                            PlaceholderColor="{DynamicResource AppTextInactive}"
                            TextColor="{DynamicResource AppTextPrimary}"
                            FontSize="16"
                            Keyboard="Numeric"
                            HorizontalTextAlignment="End"
                            Margin="12,0"
                            TextChanged="OnAmountTextChanged" />
                    </Border>

                    <Button
                        Grid.Column="1"
                        Text="+"
                        FontSize="23"
                        TextColor="{DynamicResource AppAccent}"
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        BorderColor="{DynamicResource AppBorder}"
                        BorderWidth="1"
                        CornerRadius="12"
                        Padding="0"
                        Clicked="OnAddClicked" />

                </Grid>

                <!-- LIVE CALCULATION PREVIEW -->
                <Grid
                    x:Name="LivePreview"
                    IsVisible="False"
                    Padding="18,4,18,8"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="28">

                    <VerticalStackLayout
                        Grid.Column="0"
                        Spacing="4">

                        <Label
                            Text="ALIŞ"
                            FontSize="10"
                            CharacterSpacing=".8"
                            TextColor="{DynamicResource AppTextInactive}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="PreviewBuyLabel"
                            Text="0,00"
                            FontSize="16"
                            TextColor="{DynamicResource AppTextPrimary}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="4">

                        <Label
                            Text="SATIŞ"
                            FontSize="10"
                            CharacterSpacing=".8"
                            TextColor="{DynamicResource AppTextInactive}"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="PreviewSellLabel"
                            Text="0,00"
                            FontSize="16"
                            TextColor="{DynamicResource AppTextPrimary}"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Grid>

                <BoxView
                    x:Name="PreviewDivider"
                    IsVisible="False"
                    HeightRequest="1"
                    Color="{DynamicResource AppBorder}" />

                <BoxView
                    Margin="0,4,0,0"
                    HeightRequest="1"
                    Color="{DynamicResource AppBorder}" />

                <!-- TABLE HEADER -->
                <Grid
                    Padding="0,2"
                    ColumnDefinitions="1.7*,.8*,1*,1*"
                    ColumnSpacing="6">

                    <Label
                        Text="ÜRÜN"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="{DynamicResource AppTextInactive}" />

                    <Label
                        Grid.Column="1"
                        Text="MİKTAR"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="{DynamicResource AppTextInactive}"
                        HorizontalTextAlignment="End" />

                    <Label
                        Grid.Column="2"
                        Text="ALIŞ"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="{DynamicResource AppTextInactive}"
                        HorizontalTextAlignment="End" />

                    <Label
                        Grid.Column="3"
                        Text="SATIŞ"
                        FontSize="10"
                        CharacterSpacing=".7"
                        TextColor="{DynamicResource AppTextInactive}"
                        HorizontalTextAlignment="End" />

                </Grid>

                <VerticalStackLayout
                    x:Name="RowsContainer"
                    Spacing="0">

                    <Label
                        x:Name="EmptyRowsLabel"
                        Text="Henüz satır yok. Ürün ve miktar ekleyin."
                        FontSize="12"
                        TextColor="{DynamicResource AppTextInactive}"
                        Margin="0,2,0,6" />

                </VerticalStackLayout>

                <BoxView
                    HeightRequest="1"
                    Color="{DynamicResource AppBorder}" />

                <!-- TOTAL -->
                <Grid
                    Padding="0,5"
                    ColumnDefinitions="1.7*,.8*,1*,1*"
                    ColumnSpacing="6">

                    <Label
                        Text="Toplam"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextPrimary}" />

                    <Label
                        x:Name="TotalBuyLabel"
                        Grid.Column="2"
                        Text="0,00"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppAccent}"
                        HorizontalTextAlignment="End" />

                    <Label
                        x:Name="TotalSellLabel"
                        Grid.Column="3"
                        Text="0,00"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppAccent}"
                        HorizontalTextAlignment="End" />

                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DISCLAIMER -->
        <Grid
            Grid.Row="2"
            Padding="18,10,18,22"
            BackgroundColor="{DynamicResource AppBackground}">

            <VerticalStackLayout Spacing="10">

                <BoxView
                    HeightRequest="1"
                    Color="{DynamicResource AppBorder}" />

                <Label
                    Text="Bu ekrandaki hesaplama ve fiyatlar bağlayıcı değildir. Yasal yükümlülük oluşturmaz."
                    FontSize="10"
                    TextColor="{DynamicResource AppTextInactive}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap" />

            </VerticalStackLayout>

        </Grid>


        <!-- MAZLUM SIDEBAR -->
<Grid
            x:Name="SidebarOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="False"
            BackgroundColor="#99000000"
            ZIndex="100">

            <!-- KARARTMA -->
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>

            <!-- SOL PANEL -->
            <Border
                x:Name="SidebarPanel"
                WidthRequest="330"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1"
                TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="22,32,18,18"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="12">

                    <!-- HEADER -->
                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="58,*,40"
                        ColumnSpacing="12">

                        <!-- LOGO -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            Stroke="{DynamicResource AppAccent}"
                            StrokeThickness="2"
                            BackgroundColor="Transparent">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label
                                    Text="mk"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Row="1"
                                    Text="ESTD 1998"
                                    FontSize="4"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,0,0,7" />

                            </Grid>
                        </Border>

                        <!-- WORDMARK -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">

                            <Label
                                Text="mazlum"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource AppAccent}" />

                            <Label
                                Text="KUYUMCULUK"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.6"
                                TextColor="{DynamicResource AppAccent}" />

                        </VerticalStackLayout>

                        <!-- CLOSE -->
                        <Button
                            Grid.Column="2"
                            Text="×"
                            FontSize="28"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppTextMuted}"
                            Clicked="OnSidebarCloseClicked" />

                    </Grid>

                    <!-- MENU -->
                    <ScrollView Grid.Row="2">

                        <VerticalStackLayout Spacing="0">

                            <!-- GİRİŞ -->
                            <Grid
                                x:Name="CalcAuthMenuRow"
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCalcAuthMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf2f6;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    x:Name="CalcAuthUserLabel"
                                    Grid.Column="1"
                                    Text="Giriş Yap"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />

                            <!-- HESAPLAMA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCalcCurrentPageTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf1ec;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hesaplama Aracı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />

                            <!-- ŞUBELER -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCalcBranchesTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf07b;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Şubelerimiz"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />

                            <!-- HAKKIMIZDA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAboutMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf05a;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hakkımızda"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />

                            <!-- YASAL -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLegalMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf3ed;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Yasal Uyarı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>
                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />

                            <!-- BILDIRIM -->
                            <Grid
                                x:Name="NotificationMenuRow"
                                IsVisible="False"
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnNotificationMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf0f3;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Bildirim gönder"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />
                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />

                            <!-- AYARLAR -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSettingsMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf013;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Ayarlar"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />
                            </Grid>


                        </VerticalStackLayout>

                    </ScrollView>

                    <!-- ================= FOOTER ================= -->
<VerticalStackLayout
                        Grid.Row="3"
                        Spacing="11">


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0e0;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="destek@mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0ac;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <!-- SOCIAL BUTTONS -->
                        <Grid
                            Margin="0,5,0,0"
                            ColumnDefinitions="46,46,46,*"
                            ColumnSpacing="10">


                            <Border
                                Grid.Column="0"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf095;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="17"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="1"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf16d;"
                                    FontFamily="FontAwesome6Brands-Regular"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="2"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf232;"
                                    FontFamily="FontAwesome6Brands-Regular"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <!-- LOGOUT -->
                            <Border
                                x:Name="LogoutMenuRow"
                                IsVisible="False"
                                Grid.Column="3"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1"
                                HorizontalOptions="End"
                                Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf2f5;"
                                        FontFamily="FontAwesomeSolid"
                                        FontSize="17"
                                        TextColor="{DynamicResource AppAccent}" />

                                    <Label
                                        Text="Çıkış"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource AppAccent}"
                                        VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</ContentPage>
