<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumAboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="{DynamicResource AppBackground}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid
            Grid.Row="0"
            Padding="18,12,18,14"
            ColumnDefinitions="42,42,*,74"
            ColumnSpacing="10">

            <Border
                Grid.Column="0"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="☰"
                    FontSize="21"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
            </Border>

            <Border
                Grid.Column="1"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="‹"
                    FontSize="33"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    TranslationY="-2" />
            </Border>

            <Label
                Grid.Column="2"
                Text="Hakkımızda"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{DynamicResource AppTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

            <Button
                x:Name="EditButton"
                Grid.Column="3"
                Text="Düzenle"
                IsVisible="False"
                Padding="4,0"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource AppAccent}"
                FontSize="14"
                Clicked="OnEditClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="20,22,20,42"
                Spacing="18">

                <!-- NORMAL VIEW -->
                <VerticalStackLayout
                    x:Name="DisplayPanel"
                    Spacing="20">

                    <Label
                        x:Name="TitleLabel"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource AppTextPrimary}" />

                    <VerticalStackLayout
                        x:Name="ParagraphsPanel"
                        Spacing="18" />

                    <Label
                        x:Name="LinkLabel"
                        FontSize="16"
                        TextColor="{DynamicResource AppAccent}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLinkTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- ADMIN EDIT -->
                <VerticalStackLayout
                    x:Name="EditPanel"
                    IsVisible="False"
                    Spacing="18">

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="BAŞLIK"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Border
                            BackgroundColor="{DynamicResource AppCardBackground}"
                            Stroke="{DynamicResource AppBorder}"
                            StrokeThickness="1"
                            Padding="13,2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="TitleEntry"
                                TextColor="{DynamicResource AppTextPrimary}"
                                PlaceholderColor="{DynamicResource AppTextMuted}"
                                BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="METİN"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Border
                            BackgroundColor="{DynamicResource AppCardBackground}"
                            Stroke="{DynamicResource AppBorder}"
                            StrokeThickness="1"
                            Padding="13,10">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>

                            <Editor
                                x:Name="BodyEditor"
                                HeightRequest="210"
                                AutoSize="TextChanges"
                                TextColor="{DynamicResource AppTextPrimary}"
                                Placeholder="Paragrafları boş satırla ayırın"
                                PlaceholderColor="{DynamicResource AppTextMuted}"
                                BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="BAĞLANTI METNİ"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Border
                            BackgroundColor="{DynamicResource AppCardBackground}"
                            Stroke="{DynamicResource AppBorder}"
                            StrokeThickness="1"
                            Padding="13,2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="LinkLabelEntry"
                                Placeholder="www.ornek.com"
                                PlaceholderColor="{DynamicResource AppTextMuted}"
                                TextColor="{DynamicResource AppTextPrimary}"
                                BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="7">
                        <Label
                            Text="BAĞLANTI ADRESİ"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource AppTextMuted}" />

                        <Border
                            BackgroundColor="{DynamicResource AppCardBackground}"
                            Stroke="{DynamicResource AppBorder}"
                            StrokeThickness="1"
                            Padding="13,2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="9" />
                            </Border.StrokeShape>

                            <Entry
                                x:Name="LinkUrlEntry"
                                Placeholder="https://"
                                PlaceholderColor="{DynamicResource AppTextMuted}"
                                TextColor="{DynamicResource AppTextPrimary}"
                                Keyboard="Url"
                                BackgroundColor="Transparent" />
                        </Border>
                    </VerticalStackLayout>

                    <Button
                        x:Name="SaveButton"
                        Text="Kaydet"
                        HeightRequest="50"
                        CornerRadius="9"
                        BackgroundColor="{DynamicResource AppAccent}"
                        TextColor="{DynamicResource AppBackground}"
                        FontAttributes="Bold"
                        FontSize="16"
                        Clicked="OnSaveClicked" />

                    <Label
                        x:Name="ErrorLabel"
                        IsVisible="False"
                        TextColor="#E57373"
                        FontSize="13" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    

<Grid
            x:Name="SidebarOverlay"
            Grid.RowSpan="2"
            IsVisible="False"
            BackgroundColor="#99000000"
            ZIndex="100">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer
                    Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>


            <!-- LEFT PANEL -->
            <Border
                x:Name="SidebarPanel"
                WidthRequest="330"
                HorizontalOptions="Start"
                VerticalOptions="Fill"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1"
                TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid
                    Padding="22,32,18,18"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="12"
                    VerticalOptions="Start">


                    <!-- ================= HEADER ================= -->

                    <Grid
                        Grid.Row="0"
                        ColumnDefinitions="Auto,*,40"
                        ColumnSpacing="12">

                        <!-- MK LOGO -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="58"
                            HeightRequest="58"
                            Stroke="{DynamicResource AppAccent}"
                            StrokeThickness="2"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label
                                    Text="mk"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    Margin="0,4,0,0" />

                                <Label
                                    Grid.Row="1"
                                    Text="ESTD 1998"
                                    FontSize="4"
                                    FontAttributes="Bold"
                                    CharacterSpacing="1"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    Margin="0,0,0,7" />

                            </Grid>

                        </Border>


                        <!-- WORDMARK -->
                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="0"
                            VerticalOptions="Center">

                            <Label
                                Text="mazlum"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="{DynamicResource AppAccent}" />

                            <Label
                                Text="KUYUMCULUK"
                                FontSize="10"
                                FontAttributes="Bold"
                                CharacterSpacing="1.6"
                                TextColor="{DynamicResource AppAccent}" />

                        </VerticalStackLayout>


                        <!-- CLOSE -->
                        <Button
                            Grid.Column="2"
                            Text="×"
                            FontSize="28"
                            FontAttributes="None"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="{DynamicResource AppTextMuted}"
                            VerticalOptions="Start"
                            Clicked="OnSidebarCloseClicked" />

                    </Grid>


                    

                    


                    <!-- ================= MENU ================= -->

                    <ScrollView
                        Grid.Row="2"
                        VerticalOptions="Start">

                        <VerticalStackLayout Spacing="0">

                            <!-- GIRIS -->
<Grid
                        x:Name="AuthMenuRow"
                                                Padding="7,15"
                        ColumnDefinitions="28,*"
                        ColumnSpacing="8">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuthMenuTapped" />
                        </Grid.GestureRecognizers>

                        <Label
                            Grid.Column="0"
                            Text="&#xf2f6;"
                            FontFamily="FontAwesomeSolid"
                            FontSize="18"
                            TextColor="{DynamicResource AppAccent}"
                            VerticalTextAlignment="Center" />

                        <Label
                            x:Name="AuthUserLabel"
                            Grid.Column="1"
                            Text="Giriş Yap"
                            FontSize="15"
                            TextColor="{DynamicResource AppAccent}"
                            VerticalTextAlignment="Center" />

                    </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />



                            <!-- HESAPLAMA ARACI -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnCalculationMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf1ec;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hesaplama Aracı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- SUBELER -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchesMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label
                                    Text="&#xf07b;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Şubelerimiz"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- HAKKIMIZDA -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAboutMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf05a;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Hakkımızda"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- YASAL -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLegalMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label
                                    Text="&#xf3ed;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Yasal Uyarı"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- BILDIRIM -->
                            <Grid
                                x:Name="NotificationMenuRow"
                                IsVisible="False"
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf0f3;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Bildirim gönder"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />


                            <!-- AYARLAR -->
                            <Grid
                                Padding="7,15"
                                ColumnDefinitions="28,*"
                                ColumnSpacing="8">

                                <Label
                                    Text="&#xf013;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Ayarlar"
                                    FontSize="15"
                                    TextColor="{DynamicResource AppAccent}"
                                    VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView
                                HeightRequest="1"
                                Color="{DynamicResource AppBorder}" />

                        </VerticalStackLayout>

                    </ScrollView>


                    <!-- ================= FOOTER ================= -->

                    <VerticalStackLayout
                        Grid.Row="3"
                        Spacing="11">


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0e0;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="destek@mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Spacing="10">

                            <Label
                                Text="&#xf0ac;"
                                FontFamily="FontAwesomeSolid"
                                FontSize="15"
                                TextColor="{DynamicResource AppTextMuted}" />

                            <Label
                                Text="mazlumkuyumculuk.com"
                                FontSize="11"
                                TextColor="{DynamicResource AppTextMuted}"
                                VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <!-- SOCIAL BUTTONS -->
                        <Grid
                            Margin="0,5,0,0"
                            ColumnDefinitions="46,46,46,*"
                            ColumnSpacing="10">


                            <Border
                                Grid.Column="0"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf095;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="17"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="1"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf16d;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <Border
                                Grid.Column="2"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label
                                    Text="&#xf232;"
                                    FontFamily="FontAwesomeSolid"
                                    FontSize="18"
                                    TextColor="{DynamicResource AppAccent}"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />

                            </Border>


                            <!-- LOGOUT -->
                            <Border
                                x:Name="LogoutMenuRow"
                                IsVisible="False"
                                Grid.Column="3"
                                HeightRequest="44"
                                BackgroundColor="{DynamicResource AppPanelBackground}"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1"
                                HorizontalOptions="End"
                                Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout
                                    Spacing="7"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="&#xf2f5;"
                                        FontFamily="FontAwesomeSolid"
                                        FontSize="17"
                                        TextColor="{DynamicResource AppAccent}" />

                                    <Label
                                        Text="Çıkış"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{DynamicResource AppAccent}"
                                        VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </Grid>

</Grid>
</ContentPage>
