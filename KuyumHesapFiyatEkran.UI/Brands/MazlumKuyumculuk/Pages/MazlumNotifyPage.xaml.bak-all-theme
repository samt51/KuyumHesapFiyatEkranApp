<?xml version='1.0' encoding='utf-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumNotifyPage" NavigationPage.HasNavigationBar="False" BackgroundColor="#101113">

    <Grid RowDefinitions="Auto,*">

        
        <Grid Grid.Row="0" Padding="18,12,18,14" ColumnDefinitions="42,42,*,74" ColumnSpacing="10">

            <Border
                Grid.Column="0"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="#171819"
                Stroke="#343537"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="☰"
                    FontSize="21"
                    TextColor="#D4B56A"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

            </Border>

            <Border
                Grid.Column="1"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="#171819"
                Stroke="#343537"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="‹"
                    FontSize="33"
                    TextColor="#D4B56A"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    TranslationY="-2" />

            </Border>

            <Label
                Grid.Column="2"
                Text="Bildirim gönder"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#F3F3F3"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

        </Grid>

        
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20,22,20,42" Spacing="18">

                <Label Text="Mesaj tüm bildirimleri açmış kullanıcılara iletilir. Uygulama açıkken de bildirim görünür." FontSize="14" LineHeight="1.25" TextColor="#969696" />

                <Label x:Name="ErrorLabel" IsVisible="False" FontSize="14" TextColor="#E57373" />

                <Label x:Name="SuccessLabel" Text="Bildirim gönderildi." IsVisible="False" FontSize="14" TextColor="#75C58A" />

                
                <VerticalStackLayout Spacing="7">

                    <Label Text="BAŞLIK" FontSize="12" CharacterSpacing="2" TextColor="#999999" />

                    <Border Stroke="#B99D00" StrokeThickness="1.4" BackgroundColor="#181812" StrokeShape="RoundRectangle 12" Padding="14,0">

                        <Entry x:Name="TitleEntry" Placeholder="Örn. Önemli duyuru" PlaceholderColor="#777777" TextColor="#F0F0F0" FontSize="16" MaxLength="120" HeightRequest="52" TextChanged="OnInputChanged" />

                    </Border>

                </VerticalStackLayout>

                
                <VerticalStackLayout Spacing="7">

                    <Label Text="MESAJ" FontSize="12" CharacterSpacing="2" TextColor="#999999" />

                    <Border Stroke="#3A3827" StrokeThickness="1" BackgroundColor="#181812" StrokeShape="RoundRectangle 12" Padding="14,12">

                        <Editor x:Name="BodyEditor" Placeholder="Kullanıcılara iletilecek metin…" PlaceholderColor="#777777" TextColor="#F0F0F0" FontSize="16" MaxLength="500" AutoSize="TextChanges" MinimumHeightRequest="155" TextChanged="OnInputChanged" />

                    </Border>

                </VerticalStackLayout>

                <Button x:Name="SendButton" Text="Gönder" HeightRequest="52" CornerRadius="12" BackgroundColor="#C5AA18" TextColor="#080808" FontSize="16" FontAttributes="Bold" Clicked="OnSendClicked" />

            </VerticalStackLayout>

        </ScrollView>

    <Grid x:Name="SidebarOverlay" IsVisible="False" BackgroundColor="#99000000" ZIndex="100" Grid.Row="0" Grid.RowSpan="2">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>


            
            <Border x:Name="SidebarPanel" WidthRequest="330" HorizontalOptions="Start" VerticalOptions="Fill" BackgroundColor="#171819" Stroke="#292A2B" StrokeThickness="1" TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid Padding="22,32,18,18" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" VerticalOptions="Start">


                    

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,40" ColumnSpacing="12">

                        
                        <Border Grid.Column="0" WidthRequest="58" HeightRequest="58" Stroke="#D4B56A" StrokeThickness="2" BackgroundColor="Transparent" VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label Text="mk" FontSize="20" FontAttributes="Bold" TextColor="#D4B56A" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,4,0,0" />

                                <Label Grid.Row="1" Text="ESTD 1998" FontSize="4" FontAttributes="Bold" CharacterSpacing="1" TextColor="#D4B56A" HorizontalTextAlignment="Center" Margin="0,0,0,7" />

                            </Grid>

                        </Border>


                        
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">

                            <Label Text="mazlum" FontSize="22" FontAttributes="Bold" TextColor="#D4B56A" />

                            <Label Text="KUYUMCULUK" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.6" TextColor="#D4B56A" />

                        </VerticalStackLayout>


                        
                        <Button Grid.Column="2" Text="×" FontSize="28" FontAttributes="None" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" TextColor="#92979F" VerticalOptions="Start" Clicked="OnSidebarCloseClicked" />

                    </Grid>


                    

                    


                    

                    <ScrollView Grid.Row="2" VerticalOptions="Start">

                        <VerticalStackLayout Spacing="0">

                            
<Grid x:Name="AuthMenuRow" Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuthMenuTapped" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                        <Label x:Name="AuthUserLabel" Grid.Column="1" Text="Giriş Yap" FontSize="15" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                    </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />



                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCalculationMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Hesaplama Aracı" FontSize="15" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchesMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Şubelerimiz" FontSize="15" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAboutMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Hakkımızda" FontSize="15" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLegalMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Yasal Uyarı" FontSize="15" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />


                            
                            <Grid x:Name="NotificationMenuRow" IsVisible="False" Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Bildirim gönder" FontSize="15" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Ayarlar" FontSize="15" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="#303133" />

                        </VerticalStackLayout>

                    </ScrollView>


                    

                    <VerticalStackLayout Grid.Row="3" Spacing="11">


                        <HorizontalStackLayout Spacing="10">

                            <Label Text="" FontFamily="FontAwesomeSolid" FontSize="15" TextColor="#92979F" />

                            <Label Text="destek@mazlumkuyumculuk.com" FontSize="11" TextColor="#92979F" VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <HorizontalStackLayout Spacing="10">

                            <Label Text="" FontFamily="FontAwesomeSolid" FontSize="15" TextColor="#92979F" />

                            <Label Text="mazlumkuyumculuk.com" FontSize="11" TextColor="#92979F" VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        
                        <Grid Margin="0,5,0,0" ColumnDefinitions="46,46,46,*" ColumnSpacing="10">


                            <Border Grid.Column="0" HeightRequest="44" BackgroundColor="#202117" Stroke="#3A3925" StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="17" TextColor="#D4B56A" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

                            </Border>


                            <Border Grid.Column="1" HeightRequest="44" BackgroundColor="#202117" Stroke="#3A3925" StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

                            </Border>


                            <Border Grid.Column="2" HeightRequest="44" BackgroundColor="#202117" Stroke="#3A3925" StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="#D4B56A" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

                            </Border>


                            
                            <Border x:Name="LogoutMenuRow" IsVisible="False" Grid.Column="3" HeightRequest="44" BackgroundColor="#202117" Stroke="#3A3925" StrokeThickness="1" HorizontalOptions="End" Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">

                                    <Label Text="" FontFamily="FontAwesomeSolid" FontSize="17" TextColor="#D4B56A" />

                                    <Label Text="Çıkış" FontSize="13" FontAttributes="Bold" TextColor="#D4B56A" VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </Grid>
        

    </Grid>

</ContentPage>