<?xml version='1.0' encoding='utf-8'?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages.MazlumNotifyPage" NavigationPage.HasNavigationBar="False" BackgroundColor="{DynamicResource AppBackground}">

    <Grid RowDefinitions="Auto,*">

        
        <Grid Grid.Row="0" Padding="18,12,18,14" ColumnDefinitions="42,42,*,74" ColumnSpacing="10">

            <Border
                Grid.Column="0"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="☰"
                    FontSize="21"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />

            </Border>

            <Border
                Grid.Column="1"
                WidthRequest="42"
                HeightRequest="42"
                BackgroundColor="{DynamicResource AppCardBackground}"
                Stroke="{DynamicResource AppBorder}"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="11" />
                </Border.StrokeShape>

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>

                <Label
                    Text="‹"
                    FontSize="33"
                    TextColor="{DynamicResource AppAccent}"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    TranslationY="-2" />

            </Border>

            <Label
                Grid.Column="2"
                Text="Bildirim gönder"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{DynamicResource AppTextPrimary}"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center" />

        </Grid>

        
        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="20,22,20,42" Spacing="18">

                <Label Text="Mesaj tüm bildirimleri açmış kullanıcılara iletilir. Uygulama açıkken de bildirim görünür." FontSize="14" LineHeight="1.25" TextColor="{DynamicResource AppTextMuted}" />

                <Label x:Name="ErrorLabel" IsVisible="False" FontSize="14" TextColor="#E57373" />

                <Label x:Name="SuccessLabel" Text="Bildirim gönderildi." IsVisible="False" FontSize="14" TextColor="#75C58A" />

                
                <VerticalStackLayout Spacing="7">

                    <Label Text="BAŞLIK" FontSize="12" CharacterSpacing="2" TextColor="{DynamicResource AppTextMuted}" />

                    <Border Stroke="{DynamicResource AppAccent}" StrokeThickness="1.4" BackgroundColor="{DynamicResource AppCardBackground}" StrokeShape="RoundRectangle 12" Padding="14,0">

                        <Entry x:Name="TitleEntry" Placeholder="Örn. Önemli duyuru" PlaceholderColor="{DynamicResource AppTextMuted}" TextColor="{DynamicResource AppTextPrimary}" FontSize="16" MaxLength="120" HeightRequest="52" TextChanged="OnInputChanged" />

                    </Border>

                </VerticalStackLayout>

                
                <VerticalStackLayout Spacing="7">

                    <Label Text="MESAJ" FontSize="12" CharacterSpacing="2" TextColor="{DynamicResource AppTextMuted}" />

                    <Border Stroke="{DynamicResource AppAccent}" StrokeThickness="1" BackgroundColor="{DynamicResource AppCardBackground}" StrokeShape="RoundRectangle 12" Padding="14,12">

                        <Editor x:Name="BodyEditor" Placeholder="Kullanıcılara iletilecek metin…" PlaceholderColor="{DynamicResource AppTextMuted}" TextColor="{DynamicResource AppTextPrimary}" FontSize="16" MaxLength="500" AutoSize="TextChanges" MinimumHeightRequest="155" TextChanged="OnInputChanged" />

                    </Border>

                </VerticalStackLayout>

                <Button x:Name="SendButton" Text="Gönder" HeightRequest="52" CornerRadius="12" BackgroundColor="{DynamicResource AppAccent}" TextColor="{DynamicResource AppBackground}" FontSize="16" FontAttributes="Bold" Clicked="OnSendClicked" />

            </VerticalStackLayout>

        </ScrollView>

    <Grid x:Name="SidebarOverlay" IsVisible="False" BackgroundColor="#99000000" ZIndex="100" Grid.Row="0" Grid.RowSpan="2">

            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSidebarBackdropTapped" />
            </Grid.GestureRecognizers>


            
            <Border x:Name="SidebarPanel" WidthRequest="330" HorizontalOptions="Start" VerticalOptions="Fill" BackgroundColor="{DynamicResource AppCardBackground}" Stroke="{DynamicResource AppBorder}" StrokeThickness="1" TranslationX="-340">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSidebarPanelTapped" />
                </Border.GestureRecognizers>

                <Grid Padding="22,32,18,18" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12" VerticalOptions="Start">


                    

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,40" ColumnSpacing="12">

                        
                        <Border Grid.Column="0" WidthRequest="58" HeightRequest="58" Stroke="{DynamicResource AppAccent}" StrokeThickness="2" BackgroundColor="Transparent" VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="29" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="*,Auto">

                                <Label Text="mk" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource AppAccent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" Margin="0,4,0,0" />

                                <Label Grid.Row="1" Text="ESTD 1998" FontSize="4" FontAttributes="Bold" CharacterSpacing="1" TextColor="{DynamicResource AppAccent}" HorizontalTextAlignment="Center" Margin="0,0,0,7" />

                            </Grid>

                        </Border>


                        
                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">

                            <Label Text="mazlum" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource AppAccent}" />

                            <Label Text="KUYUMCULUK" FontSize="10" FontAttributes="Bold" CharacterSpacing="1.6" TextColor="{DynamicResource AppAccent}" />

                        </VerticalStackLayout>


                        
                        <Button Grid.Column="2" Text="×" FontSize="28" FontAttributes="None" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="Transparent" TextColor="{DynamicResource AppTextMuted}" VerticalOptions="Start" Clicked="OnSidebarCloseClicked" />

                    </Grid>


                    

                    


                    

                    <ScrollView Grid.Row="2" VerticalOptions="Start">

                        <VerticalStackLayout Spacing="0">

                            
<Grid x:Name="AuthMenuRow" Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAuthMenuTapped" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0" Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                        <Label x:Name="AuthUserLabel" Grid.Column="1" Text="Giriş Yap" FontSize="15" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                    </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />



                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCalculationMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Hesaplama Aracı" FontSize="15" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBranchesMenuTapped" />
                                </Grid.GestureRecognizers>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Şubelerimiz" FontSize="15" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAboutMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Hakkımızda" FontSize="15" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLegalMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Yasal Uyarı" FontSize="15" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />


                            
                            <Grid x:Name="NotificationMenuRow" IsVisible="False" Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnNotificationMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Bildirim gönder" FontSize="15" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />


                            
                            <Grid Padding="7,15" ColumnDefinitions="28,*" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSettingsMenuTapped" />
                                </Grid.GestureRecognizers>


                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                                <Label Grid.Column="1" Text="Ayarlar" FontSize="15" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                            </Grid>

                            <BoxView HeightRequest="1" Color="{DynamicResource AppBorder}" />

                        </VerticalStackLayout>

                    </ScrollView>


                    

                    <VerticalStackLayout Grid.Row="3" Spacing="11">


                        <HorizontalStackLayout Spacing="10">

                            <Label Text="" FontFamily="FontAwesomeSolid" FontSize="15" TextColor="{DynamicResource AppTextMuted}" />

                            <Label Text="destek@mazlumkuyumculuk.com" FontSize="11" TextColor="{DynamicResource AppTextMuted}" VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        <HorizontalStackLayout Spacing="10">

                            <Label Text="" FontFamily="FontAwesomeSolid" FontSize="15" TextColor="{DynamicResource AppTextMuted}" />

                            <Label Text="mazlumkuyumculuk.com" FontSize="11" TextColor="{DynamicResource AppTextMuted}" VerticalTextAlignment="Center" />

                        </HorizontalStackLayout>


                        
                        <Grid Margin="0,5,0,0" ColumnDefinitions="46,46,46,*" ColumnSpacing="10">


                            <Border Grid.Column="0" HeightRequest="44" BackgroundColor="{DynamicResource AppPanelBackground}" Stroke="{DynamicResource AppBorder}" StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="17" TextColor="{DynamicResource AppAccent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

                            </Border>


                            <Border Grid.Column="1" HeightRequest="44" BackgroundColor="{DynamicResource AppPanelBackground}" Stroke="{DynamicResource AppBorder}" StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

                            </Border>


                            <Border Grid.Column="2" HeightRequest="44" BackgroundColor="{DynamicResource AppPanelBackground}" Stroke="{DynamicResource AppBorder}" StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Label Text="" FontFamily="FontAwesomeSolid" FontSize="18" TextColor="{DynamicResource AppAccent}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />

                            </Border>


                            
                            <Border x:Name="LogoutMenuRow" IsVisible="False" Grid.Column="3" HeightRequest="44" BackgroundColor="{DynamicResource AppPanelBackground}" Stroke="{DynamicResource AppBorder}" StrokeThickness="1" HorizontalOptions="End" Padding="12,0">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="11" />
                                </Border.StrokeShape>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLogoutTapped" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout Spacing="7" VerticalOptions="Center">

                                    <Label Text="" FontFamily="FontAwesomeSolid" FontSize="17" TextColor="{DynamicResource AppAccent}" />

                                    <Label Text="Çıkış" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource AppAccent}" VerticalTextAlignment="Center" />

                                </HorizontalStackLayout>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </Grid>
        

    </Grid>

</ContentPage>