using KuyumHesapFiyatEkran.UI.Brands.MazlumKuyumculuk.Pages;
using KuyumHesapFiyatEkran.UI.Services;

namespace KuyumHesapFiyatEkran.UI
{
    public partial class App : Application
    {
        public static event EventHandler? AppSleeping;
        public static event EventHandler? AppResumed;

        public App(
            AppShell appShell,
            MazlumTvPage mazlumTvPage,
            BrandSettings brandSettings)
        {
            InitializeComponent();

            AppThemeManager.ApplySelectedTheme(Resources);

            var isMazlum =
                string.Equals(
                    brandSettings.Key,
                    "Mazlum",
                    StringComparison.OrdinalIgnoreCase);

            var isAndroidTv =
                DeviceInfo.Platform == DevicePlatform.Android &&
                DeviceInfo.Idiom == DeviceIdiom.TV;

            if (isMazlum && isAndroidTv)
            {
                MainPage = new NavigationPage(mazlumTvPage)
                {
                    BarBackgroundColor = Colors.Black,
                    BarTextColor = Colors.White
                };

                NavigationPage.SetHasNavigationBar(
                    mazlumTvPage,
                    false);
            }
            else
            {
                MainPage = appShell;
            }
        }

        protected override void OnSleep()
        {
            AppSleeping?.Invoke(
                this,
                EventArgs.Empty);

            base.OnSleep();
        }

        protected override void OnResume()
        {
            base.OnResume();

            if (AppThemeManager.GetThemeSelection() ==
                ThemeSelection.Auto)
            {
                AppThemeManager.ApplySelectedTheme(
                    Resources);
            }

            AppResumed?.Invoke(
                this,
                EventArgs.Empty);
        }
    }
}
