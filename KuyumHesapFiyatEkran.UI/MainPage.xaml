<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="MainPageRoot"
             x:Class="KuyumHesapFiyatEkran.UI.MainPage"
             Title="Canlı Fiyatlar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AppBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Active page theme: white/gold. The old black/gold values are kept in Theme.GoldBlack.xaml. -->
            <Color x:Key="AppBackground">#FFFFFF</Color>
            <Color x:Key="AppCardBackground">#FFFFFF</Color>
            <Color x:Key="AppPanelBackground">#FFFFFF</Color>
            <Color x:Key="AppAlternateRowBackground">#FAF6EA</Color>
            <Color x:Key="AppBorder">#D4AF37</Color>
            <Color x:Key="AppAccent">#D4AF37</Color>
            <Color x:Key="AppTextPrimary">#2F2A1D</Color>
            <Color x:Key="AppTextMuted">#9A7417</Color>
            <Color x:Key="AppTextInactive">#A8872B</Color>
            <Color x:Key="AppBrandText">#231F20</Color>
            <Color x:Key="AppHeaderText">#111111</Color>
            <Color x:Key="AppPositive">#1FA463</Color>
            <Color x:Key="AppNegative">#D84555</Color>
            <Color x:Key="AppTickerBackground">#FFFFFF</Color>
            <Color x:Key="AppTickerCardBackground">#FFF9E8</Color>
            <Color x:Key="AppTickerText">#2F2A1D</Color>
            <Color x:Key="AppLoadingBackground">#FFFFFF</Color>
            <x:Double x:Key="RateRowHeight">58</x:Double>
            <Thickness x:Key="RateRowPadding">10,5</Thickness>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootLayout"
          RowDefinitions="*,Auto">
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <Grid x:Name="ContentGrid"
                  Padding="4,8,4,18"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="0">
                <Border x:Name="HeaderCard"
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        Padding="8,6,6,6"
                        HeightRequest="72">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid x:Name="HeaderContent"
                          RowDefinitions="Auto"
                          RowSpacing="0">
                        <Grid x:Name="HeaderTopGrid"
                              ColumnDefinitions="34,146,*,50"
                              ColumnSpacing="6"
                              HeightRequest="56"
                              VerticalOptions="Center">
                            <Button x:Name="FlyoutMenuButton"
                                    Text="☰"
                                    Padding="0"
                                    WidthRequest="34"
                                    HeightRequest="44"
                                    FontSize="24"
                                    FontAttributes="Bold"
                                    TextColor="{DynamicResource AppAccent}"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    Clicked="OnFlyoutMenuButtonClicked"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Start" />

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <Border x:Name="BrandLogoFrame"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="#050505"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image x:Name="BrandLogoImage"
                                               Source="aslan_logo.png"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               Aspect="AspectFit" />
                                        <Label x:Name="BrandLogoFallback"
                                               IsVisible="False"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource AppAccent}"
                                               FontAutoScalingEnabled="False"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout x:Name="BrandTextStack"
                                                     WidthRequest="98"
                                                     Spacing="-4"
                                                     VerticalOptions="Center">
                                    <Label x:Name="BrandAslanLabel"
                                           FontAttributes="Bold"
                                           FontSize="27"
                                           TextColor="{DynamicResource AppBrandText}"
                                           CharacterSpacing="0"
                                           FontAutoScalingEnabled="False"
                                           HorizontalOptions="Start"
                                           LineBreakMode="NoWrap"
                                           MaxLines="1" />
                                    <Label x:Name="BrandKuyumculukLabel"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="{DynamicResource AppBrandText}"
                                           CharacterSpacing="0"
                                           FontAutoScalingEnabled="False"
                                           HorizontalOptions="Start"
                                           AnchorX="0"
                                           ScaleX="0.94"
                                           LineBreakMode="NoWrap"
                                           MaxLines="1" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Column="2"
                                                 Spacing="0"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label Text="Son G&#252;ncelleme"
                                       FontSize="11"
                                       TextColor="{DynamicResource AppTextMuted}"
                                       FontAutoScalingEnabled="False"
                                       HorizontalTextAlignment="End" />
                                <Label Text="{Binding LastUpdate}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextPrimary}"
                                       FontAutoScalingEnabled="False"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="NoWrap"
                                       MaxLines="1" />
                            </VerticalStackLayout>

                            <Border x:Name="ThemeToggle"
                                    Grid.Column="3"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Padding="0"
                                    StrokeThickness="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="ThemeToggleIcon"
                                       FontSize="23"
                                       FontAttributes="Bold"
                                       FontAutoScalingEnabled="False"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>

                    </Grid>
                </Border>

                <Grid x:Name="CategoryTabs"
                      Grid.Row="1"
                      ColumnSpacing="0"
                      HeightRequest="36"
                      Margin="0,-1,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SarrafiyeTabColumn"
                                          Width="*" />
                        <ColumnDefinition x:Name="MadenTabColumn"
                                          Width="*" />
                        <ColumnDefinition x:Name="DovizTabColumn"
                                          Width="0" />
                    </Grid.ColumnDefinitions>

                    <BoxView x:Name="SarrafiyeTabIndicator"
                             Grid.Row="0"
                             Grid.Column="0"
                             HeightRequest="4"
                             HorizontalOptions="Fill"
                             VerticalOptions="Start"
                             BackgroundColor="{DynamicResource AppAccent}" />
                    <BoxView x:Name="MadenTabIndicator"
                             Grid.Row="0"
                             Grid.Column="1"
                             HeightRequest="4"
                             HorizontalOptions="Fill"
                             VerticalOptions="Start"
                             BackgroundColor="{DynamicResource AppAccent}" />
                    <BoxView x:Name="DovizTabIndicator"
                             Grid.Row="0"
                             Grid.Column="2"
                             HeightRequest="4"
                             HorizontalOptions="Fill"
                             VerticalOptions="Start"
                             BackgroundColor="{DynamicResource AppAccent}" />

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  IsVisible="{Binding IsSarrafiyeEnabled}">
                                <Label x:Name="SarrafiyeTabLabel"
                                       Text="SARRAF&#304;YE"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextInactive}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                                              CommandParameter="Sarrafiye" />
                                    </Label.GestureRecognizers>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.IsSarrafiyeSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor"
                                                    Value="{DynamicResource AppTextPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  IsVisible="{Binding IsMadenEnabled}">
                                <Label x:Name="MadenTabLabel"
                                       Text="MADEN"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextInactive}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                                              CommandParameter="Maden" />
                                    </Label.GestureRecognizers>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.IsMadenSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor"
                                                    Value="{DynamicResource AppTextPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Grid.Column="2"
                                  IsVisible="{Binding IsDovizEnabled}">
                                <Label x:Name="DovizTabLabel"
                                       Text="D&#214;V&#304;Z"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextInactive}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                              CommandParameter="Doviz" />
                                    </Label.GestureRecognizers>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsDovizSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor"
                                                    Value="{DynamicResource AppTextPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>
                        </Grid>

                <Border Grid.Row="2"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppPanelBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto,*">
                        <Grid x:Name="TableHeader"
                              ColumnDefinitions="36,*,*,*"
                              ColumnSpacing="4"
                              Padding="10,10"
                              BackgroundColor="{DynamicResource AppAccent}">
                            <Label Text="{Binding SelectedCategoryTitle}"
                                   Grid.ColumnSpan="2"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   CharacterSpacing="1"
                                   TextColor="{DynamicResource AppHeaderText}"
                                   FontAutoScalingEnabled="False"
                                   LineBreakMode="NoWrap"
                                   MaxLines="1"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="ALI&#350;"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   TextColor="{DynamicResource AppHeaderText}"
                                   FontAutoScalingEnabled="False"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="3"
                                   Text="SATI&#350;"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   TextColor="{DynamicResource AppHeaderText}"
                                   FontAutoScalingEnabled="False"
                                   HorizontalTextAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1"
                              RowDefinitions="Auto,*">
                            <Label Text="{Binding ErrorMessage}"
                                   Padding="12,8"
                                   TextColor="{DynamicResource AppNegative}"
                                   IsVisible="{Binding HasErrorMessage}" />

                            <CollectionView x:Name="RatesCollectionView"
                                            Grid.Row="1"
                                            Margin="0"
                                            ItemsSource="{Binding DisplayRates}"
                                            ItemSizingStrategy="MeasureFirstItem"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="36,*,*,*"
                                              ColumnSpacing="4"
                                              Padding="{DynamicResource RateRowPadding}"
                                              HeightRequest="{DynamicResource RateRowHeight}"
                                              BackgroundColor="{DynamicResource AppPanelBackground}">
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid"
                                                             Binding="{Binding IsAlternateRow}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{DynamicResource AppAlternateRowBackground}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Grid"
                                                             Binding="{Binding IsAlternateRow}"
                                                             Value="False">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{DynamicResource AppPanelBackground}" />
                                                </DataTrigger>
                                            </Grid.Triggers>

                                                <Button Text="{Binding FavoriteText}"
                                                        Padding="0"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        FontSize="19"
                                                        TextColor="{DynamicResource AppAccent}"
                                                        BackgroundColor="Transparent"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFavoriteCommand}"
                                                        CommandParameter="{Binding .}"
                                                        VerticalOptions="Center" />

                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="1"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           FontAutoScalingEnabled="False"
                                                           TextColor="{DynamicResource AppTextPrimary}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="2" />
                                                    <Label Text="{Binding Code}"
                                                           FontSize="11"
                                                           FontAutoScalingEnabled="False"
                                                           TextColor="{DynamicResource AppTextMuted}"
                                                           IsVisible="{Binding HasCode}" />
                                                </VerticalStackLayout>

                                                <Label Grid.Column="2"
                                                       Text="{Binding Buy}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       FontAutoScalingEnabled="False"
                                                       TextColor="{DynamicResource AppTextPrimary}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="NoWrap"
                                                       MaxLines="1" />

                                                <VerticalStackLayout Grid.Column="3"
                                                                     Spacing="1"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding Sell}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           FontAutoScalingEnabled="False"
                                                           TextColor="{DynamicResource AppTextPrimary}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="NoWrap"
                                                           MaxLines="1" />
                                                    <Label Text="{Binding TrendText}"
                                                           FontSize="10"
                                                           FontAutoScalingEnabled="False"
                                                           TextColor="{DynamicResource AppPositive}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="NoWrap"
                                                           MaxLines="1"
                                                           Loaded="OnTrendLabelLoaded"
                                                           Unloaded="OnTrendLabelUnloaded">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsUp}"
                                                                         Value="False">
                                                                <Setter Property="TextColor"
                                                                        Value="{DynamicResource AppNegative}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </VerticalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </RefreshView>

        <Grid Grid.Row="0"
              BackgroundColor="{DynamicResource AppLoadingBackground}"
              IsVisible="{Binding IsInitialLoading}">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16">
                <Border WidthRequest="240"
                        HeightRequest="240"
                        Padding="0"
                        StrokeThickness="0"
                        BackgroundColor="#050505">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image x:Name="LoadingLogoImage"
                               Source="aslan_logo.png"
                               WidthRequest="240"
                               HeightRequest="240"
                               Aspect="AspectFit" />
                        <Label x:Name="LoadingLogoFallback"
                               IsVisible="False"
                               FontSize="58"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AppAccent}"
                               FontAutoScalingEnabled="False"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <ActivityIndicator IsRunning="{Binding IsInitialLoading}"
                                   Color="{DynamicResource AppAccent}"
                                   WidthRequest="38"
                                   HeightRequest="38" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="TickerViewport"
              Grid.Row="1"
              HeightRequest="54"
              Padding="0"
              BackgroundColor="{DynamicResource AppTickerBackground}"
              IsClippedToBounds="True"
              IsVisible="{Binding IsTickerVisible}">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnTickerPanUpdated" />
            </Grid.GestureRecognizers>

            <HorizontalStackLayout x:Name="TickerContent"
                                   Spacing="28"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                <Border x:Name="TickerSegment"
                        Padding="18,7"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppTickerCardBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout x:Name="TickerSegmentContent"
                                           Spacing="14" />
                </Border>

                <Border Padding="18,7"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppTickerCardBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout x:Name="TickerSegmentCloneContent"
                                           Spacing="14" />
                </Border>
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
