<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:KuyumHesapFiyatEkran.UI.Views"
             x:Name="MainPageRoot"
             x:Class="KuyumHesapFiyatEkran.UI.MainPage"
             Title="Canlı Fiyatlar"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AppBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Active page theme: white/gold. The old black/gold values are kept in Theme.GoldBlack.xaml. -->
            <Color x:Key="AppBackground">#FFFFFF</Color>
            <Color x:Key="AppCardBackground">#FFFFFF</Color>
            <Color x:Key="AppPanelBackground">#FFFFFF</Color>
            <Color x:Key="AppAlternateRowBackground">#FAF6EA</Color>
            <Color x:Key="AppBorder">#D4AF37</Color>
            <Color x:Key="AppAccent">#D4AF37</Color>
            <Color x:Key="AppTextPrimary">#2F2A1D</Color>
            <Color x:Key="AppTextMuted">#9A7417</Color>
            <Color x:Key="AppTextInactive">#A8872B</Color>
            <Color x:Key="AppBrandText">#231F20</Color>
            <Color x:Key="AppHeaderText">#111111</Color>
            <Color x:Key="AppPositive">#1FA463</Color>
            <Color x:Key="AppNegative">#D84555</Color>
            <Color x:Key="AppTickerBackground">#FFFFFF</Color>
            <Color x:Key="AppTickerCardBackground">#FFF9E8</Color>
            <Color x:Key="AppTickerText">#2F2A1D</Color>
            <Color x:Key="AppLoadingBackground">#FFFFFF</Color>
            <Color x:Key="RateNameText">#2F2A1D</Color>
            <Color x:Key="RatePriceText">#2F2A1D</Color>
            <Color x:Key="RateDivider">#1AD4AF37</Color>
            <x:Double x:Key="RateRowHeight">46</x:Double>
            <Thickness x:Key="RateRowPadding">10,2</Thickness>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootLayout"
          RowDefinitions="*,Auto,Auto">
        <RefreshView Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <Grid x:Name="ContentGrid"
                  Padding="4,4,4,4"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="0">
                <Border x:Name="SalihHeaderCard"
                        IsVisible="False"
                        Grid.Row="0"
                        Stroke="#2F2512"
                        StrokeThickness="0"
                        Padding="0"
                        HeightRequest="120"
                        BackgroundColor="#070707">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="50,*,50"
                          RowDefinitions="*"
                          Padding="12,6,12,6">
                        <GraphicsView x:Name="SalihHeaderArt"
                                      Grid.ColumnSpan="3"
                                      InputTransparent="True" />
                        
                        <!-- Empty spacer on left to balance the right theme toggle -->
                        <BoxView Grid.Column="0" BackgroundColor="Transparent" WidthRequest="50" HeightRequest="50" />
                        
                        <!-- Centered Logo, Titles and Update Badge -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center">
                            <Grid x:Name="SalihLogoMark"
                                  WidthRequest="54"
                                  HeightRequest="54"
                                  HorizontalOptions="Center"
                                  Margin="0,0,0,2">
                                <Image x:Name="SalihLogoImage"
                                       Source="sinan_logo.png"
                                       Aspect="AspectFit"
                                       WidthRequest="54"
                                       HeightRequest="54"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Label x:Name="SalihLogoDiamondLabel" IsVisible="False" />
                                <Label x:Name="SalihLogoMonogramLabel" IsVisible="False" />
                            </Grid>
                            
                            <VerticalStackLayout Spacing="-2" HorizontalOptions="Center">
                                <Label x:Name="SalihBrandNameLabel"
                                       Text="SALİH ÇETİNKAYA"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"
                                       TextColor="{DynamicResource AppAccent}"
                                       FontFamily="serif"
                                       FontAutoScalingEnabled="False"
                                       HorizontalTextAlignment="Center" />
                                <Label x:Name="SalihBrandSubtitleLabel"
                                       Text="KUYUMCULUK"
                                       FontSize="9"
                                       CharacterSpacing="2"
                                       FontAttributes="Bold"
                                       FontFamily="serif"
                                       TextColor="{DynamicResource AppAccent}"
                                       FontAutoScalingEnabled="False"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            
                            <Border Padding="6,2"
                                    Stroke="#5E4515"
                                    StrokeThickness="1"
                                    BackgroundColor="#121212"
                                    HorizontalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <HorizontalStackLayout Spacing="4">
                                    <views:LucideIcon Kind="Clock3" Size="12"
                                                      IconColor="#D4A72C" />
                                    <Label Text="GÜNCELLEME:"
                                           FontSize="8"
                                           FontAttributes="Bold"
                                           TextColor="{DynamicResource AppAccent}"
                                           FontAutoScalingEnabled="False"
                                           VerticalTextAlignment="Center" />
                                    <Label Text="{Binding LastUpdate}"
                                           FontSize="8"
                                           TextColor="{DynamicResource AppTextPrimary}"
                                           FontAutoScalingEnabled="False"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="NoWrap" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                        
                        <Border x:Name="SalihThemeToggle"
                                Grid.Column="2"
                                WidthRequest="40"
                                HeightRequest="40"
                                Padding="0"
                                Stroke="{DynamicResource AppBorder}"
                                StrokeThickness="1"
                                BackgroundColor="#101010"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                            </Border.GestureRecognizers>
                            <views:LucideIcon x:Name="SalihThemeToggleIcon"
                                              Kind="Moon" Size="18"
                                              IconColor="#D4A72C" />
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="HeaderCard"
                        Grid.Row="0"
                        BackgroundColor="{DynamicResource AppCardBackground}"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        Padding="8,6,6,6"
                        HeightRequest="72">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid x:Name="HeaderContent"
                          RowDefinitions="Auto"
                          RowSpacing="0">
                        <Grid x:Name="HeaderTopGrid"
                              ColumnDefinitions="34,146,*,50"
                              ColumnSpacing="6"
                              HeightRequest="56"
                              VerticalOptions="Center">

                            <Grid x:Name="SalihPriceBackLabel"
                                   IsVisible="False"
                                   WidthRequest="42"
                                   HeightRequest="56"
                                   BackgroundColor="Transparent"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSalihPriceBackTapped" />
                                </Grid.GestureRecognizers>
                                <views:LucideIcon x:Name="SalihPriceBackIcon" Kind="ChevronLeft" Size="24" IconColor="#17202B" />
                            </Grid>

                            <Label x:Name="SalihPriceTitleLabel"
                                   IsVisible="False"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Text="Altın Fiyatları"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#17202B"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />

                            <Grid x:Name="SalihPriceRefreshLabel"
                                   IsVisible="False"
                                   Grid.Column="3"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill">
                                <views:LucideIcon x:Name="SalihPriceRefreshIcon" Kind="RefreshCw" Size="23" IconColor="#17202B" />
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                                </Grid.GestureRecognizers>
                            </Grid>

                            <Border x:Name="FlyoutMenuButton"
                                    Grid.Column="0"
                                    WidthRequest="34"
                                    HeightRequest="34"
                                    Padding="0"
                                    Stroke="{DynamicResource AppBorder}"
                                    StrokeThickness="1"
                                    BackgroundColor="{DynamicResource AppCardBackground}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnFlyoutMenuButtonClicked" />
                                </Border.GestureRecognizers>
                                <views:LucideIcon Kind="Menu" Size="22"
                                                  IconColor="#D4A72C" />
                            </Border>

                            <HorizontalStackLayout Grid.Column="1"
                                                   Spacing="6"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                <Border x:Name="BrandLogoFrame"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        StrokeThickness="0"
                                        BackgroundColor="#050505"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image x:Name="BrandLogoImage"
                                               Source="aslan_logo.png"
                                               WidthRequest="40"
                                               HeightRequest="40"
                                               Aspect="AspectFit" />
                                        <Label x:Name="BrandLogoFallback"
                                               IsVisible="False"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{DynamicResource AppAccent}"
                                               FontAutoScalingEnabled="False"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout x:Name="BrandTextStack"
                                                     WidthRequest="98"
                                                     Spacing="-4"
                                                     VerticalOptions="Center">
                                    <Label x:Name="BrandAslanLabel"
                                           FontAttributes="Bold"
                                           FontSize="27"
                                           TextColor="{DynamicResource AppBrandText}"
                                           CharacterSpacing="0"
                                           FontAutoScalingEnabled="False"
                                           HorizontalOptions="Start"
                                           LineBreakMode="NoWrap"
                                           MaxLines="1" />
                                    <Label x:Name="BrandKuyumculukLabel"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="{DynamicResource AppBrandText}"
                                           CharacterSpacing="0"
                                           FontAutoScalingEnabled="False"
                                           HorizontalOptions="Start"
                                           AnchorX="0"
                                           ScaleX="0.94"
                                           LineBreakMode="NoWrap"
                                           MaxLines="1" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <VerticalStackLayout x:Name="LastUpdateContainer"
                                                 Grid.Column="2"
                                                 Spacing="0"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="End">
                                <Label x:Name="LastUpdateTitleLabel"
                                       Text="Son Güncelleme"
                                       FontSize="11"
                                       TextColor="{DynamicResource AppTextMuted}"
                                       FontAutoScalingEnabled="False"
                                       HorizontalTextAlignment="End" />
                                <Label x:Name="LastUpdateValueLabel"
                                       Text="{Binding LastUpdate}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextPrimary}"
                                       FontAutoScalingEnabled="False"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="NoWrap"
                                       MaxLines="1" />
                            </VerticalStackLayout>

                            <Border x:Name="ThemeToggle"
                                    Grid.Column="3"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Padding="0"
                                    StrokeThickness="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                                </Border.GestureRecognizers>
                                <views:LucideIcon x:Name="ThemeToggleIcon"
                                                  Kind="Moon" Size="23" />
                            </Border>
                        </Grid>

                    </Grid>
                </Border>

                <Border x:Name="CategoryTabs"
                        Grid.Row="1"
                        Margin="12,4,12,6"
                        Padding="2"
                        HeightRequest="46"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppTickerCardBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="23" />
                    </Border.StrokeShape>
                    <Grid x:Name="CategoryTabsGrid"
                          ColumnSpacing="0"
                          Padding="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SarrafiyeTabColumn" Width="*" />
                            <ColumnDefinition x:Name="MadenTabColumn" Width="*" />
                            <ColumnDefinition x:Name="DovizTabColumn" Width="0" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="SarrafiyeTabIndicator"
                                 Grid.Row="0"
                                 Grid.Column="0"
                                 HeightRequest="4"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start"
                                 BackgroundColor="{DynamicResource AppAccent}" />
                        <BoxView x:Name="MadenTabIndicator"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 HeightRequest="4"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start"
                                 BackgroundColor="{DynamicResource AppAccent}" />
                        <BoxView x:Name="DovizTabIndicator"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 HeightRequest="4"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start"
                                 BackgroundColor="{DynamicResource AppAccent}" />

                        <Border x:Name="SarrafiyeTabFrame"
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="2"
                                Padding="0"
                                StrokeThickness="0"
                                IsVisible="{Binding IsSarrafiyeEnabled}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid x:Name="SarrafiyeTabCell"
                              Grid.Row="1"
                              Grid.Column="0"
                              IsVisible="{Binding IsSarrafiyeEnabled}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                                      CommandParameter="Sarrafiye" />
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="6">
                                <Path x:Name="SarrafiyeTabIcon"
                                      Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 12 20 C 7.59 20 4 16.41 4 12 C 4 7.59 7.59 4 12 4 C 16.41 4 20 7.59 20 12 C 20 16.41 16.41 20 12 20 Z M 12 7 C 9.24 7 7 9.24 7 12 C 7 14.76 9.24 17 12 17 C 14.76 17 17 14.76 17 12 C 17 9.24 14.76 7 12 7 Z"
                                      WidthRequest="15"
                                      HeightRequest="15"
                                      Aspect="Uniform"
                                      Fill="{DynamicResource AppTextInactive}"
                                      IsVisible="False" />
                                <Label x:Name="SarrafiyeTabLabel"
                                       Text="SARRAFİYE"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextInactive}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Border x:Name="MadenTabFrame"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="2"
                                Padding="0"
                                StrokeThickness="0"
                                IsVisible="{Binding IsMadenEnabled}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid x:Name="MadenTabCell"
                              Grid.Row="1"
                              Grid.Column="1"
                              IsVisible="{Binding IsMadenEnabled}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.SelectCategoryCommand}"
                                                      CommandParameter="Maden" />
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="6">
                                <Path x:Name="MadenTabIcon"
                                      Data="M 12 2 L 19.3 8 L 12 22 L 4.7 8 Z M 12 4.8 L 16.6 8.5 L 12 19 L 7.4 8.5 Z"
                                      WidthRequest="15"
                                      HeightRequest="15"
                                      Aspect="Uniform"
                                      Fill="{DynamicResource AppTextInactive}"
                                      IsVisible="False" />
                                <Label x:Name="MadenTabLabel"
                                       Text="MADEN"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextInactive}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>

                        <Border x:Name="DovizTabFrame"
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="2"
                                Padding="0"
                                StrokeThickness="0"
                                IsVisible="{Binding IsDovizEnabled}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                        </Border>
                        <Grid x:Name="DovizTabCell"
                              Grid.Row="1"
                              Grid.Column="2"
                              IsVisible="{Binding IsDovizEnabled}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                      CommandParameter="Doviz" />
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Spacing="6">
                                <Path x:Name="DovizTabIcon"
                                      Data="M 17 4 L 17 8 L 5 8 L 5 11 L 17 11 L 17 15 L 23 9.5 Z M 7 13 L 1 18.5 L 7 24 L 7 20 L 19 20 L 19 17 L 7 17 Z"
                                      WidthRequest="15"
                                      HeightRequest="15"
                                      Aspect="Uniform"
                                      Fill="{DynamicResource AppTextInactive}"
                                      IsVisible="False" />
                                <Label x:Name="DovizTabLabel"
                                       Text="DÖVİZ"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{DynamicResource AppTextInactive}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="RatesTableBorder"
                        Grid.Row="2"
                        Margin="12,0,12,0"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppPanelBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>

                    <Grid RowDefinitions="Auto,*">
                        <Grid x:Name="TableHeader"
                              ColumnDefinitions="40,34,*,88,98"
                              ColumnSpacing="3"
                              Padding="12,12"
                              BackgroundColor="{DynamicResource AppAccent}">
                            <Label x:Name="TableCategoryHeaderLabel"
                                   Text="{Binding SelectedCategoryTitle}"
                                   Grid.ColumnSpan="3"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   CharacterSpacing="1"
                                   TextColor="{DynamicResource AppHeaderText}"
                                   FontAutoScalingEnabled="False"
                                   LineBreakMode="NoWrap"
                                   MaxLines="1"
                                   VerticalOptions="Center" />
                            <Label x:Name="TableBuyHeaderLabel"
                                   Grid.Column="3"
                                   Text="ALIŞ"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   TextColor="{DynamicResource AppHeaderText}"
                                   FontAutoScalingEnabled="False"
                                   HorizontalTextAlignment="Center" />
                            <Label x:Name="TableSellHeaderLabel"
                                   Grid.Column="4"
                                   Text="SATIŞ"
                                   FontAttributes="Bold"
                                   FontSize="17"
                                   TextColor="{DynamicResource AppHeaderText}"
                                   FontAutoScalingEnabled="False"
                                   HorizontalTextAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1"
                              RowDefinitions="Auto,*">
                            <Label Text="{Binding ErrorMessage}"
                                   Padding="12,8"
                                   TextColor="{DynamicResource AppNegative}"
                                   IsVisible="{Binding HasErrorMessage}" />

                            <CollectionView x:Name="RatesCollectionView"
                                            Grid.Row="1"
                                            Margin="0"
                                            VerticalOptions="Fill"
                                            ItemsSource="{Binding DisplayRates}"
                                            ItemSizingStrategy="MeasureAllItems"
                                            SelectionMode="None">
                                <CollectionView.ItemTemplate>
	                                    <DataTemplate>
	                                        <Grid ColumnDefinitions="40,34,*,88,98"
	                                              ColumnSpacing="3"
	                                              Padding="{DynamicResource RateRowPadding}"
	                                              HeightRequest="{DynamicResource RateRowHeight}"
                                                  VerticalOptions="Start"
                                                  BackgroundColor="{DynamicResource AppPanelBackground}">
                                            <Grid.Triggers>
                                                <DataTrigger TargetType="Grid"
                                                             Binding="{Binding IsAlternateRow}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{DynamicResource AppAlternateRowBackground}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Grid"
                                                             Binding="{Binding IsAlternateRow}"
                                                             Value="False">
                                                    <Setter Property="BackgroundColor"
                                                            Value="{DynamicResource AppPanelBackground}" />
                                                </DataTrigger>
                                            </Grid.Triggers>

                                                <Grid WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleFavoriteCommand}"
                                                                              CommandParameter="{Binding .}" />
                                                    </Grid.GestureRecognizers>
                                                    <views:LucideIcon Kind="Star" Size="20" IconColor="#D4A72C" IsVisible="{Binding IsNotFavorite}" />
                                                    <views:LucideIcon Kind="Star" Size="20" IconColor="#D4A72C" Filled="True" IsVisible="{Binding IsFavorite}" />
                                                </Grid>

                                                <Border Grid.Column="1"
                                                        IsVisible="{DynamicResource ShowRateProductIcon}"
                                                        WidthRequest="30" HeightRequest="30" Padding="5"
                                                        BackgroundColor="#FFF3C5" StrokeThickness="0">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="15" /></Border.StrokeShape>
                                                    <views:LucideIcon Kind="CircleDollarSign" Size="20" IconColor="#D6A72C" />
                                                </Border>

                                                <Grid Grid.Column="{DynamicResource RateProductNameColumn}"
                                                      Grid.ColumnSpan="{DynamicResource RateProductNameColumnSpan}"
                                                      ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="0"
                                                      VerticalOptions="Center">
                                                    <VerticalStackLayout Grid.Column="0"
                                                                     Spacing="1"
                                                                     VerticalOptions="Center">
	                                                    <Label Text="{Binding DisplayName}"
 	                                                           FontSize="14"
 	                                                           FontAttributes="Bold"
 	                                                           FontAutoScalingEnabled="False"
 	                                                           TextColor="{DynamicResource RateNameText}"
 	                                                           LineBreakMode="TailTruncation"
 	                                                           MaxLines="2" />
                                                    <Label Text="{Binding Code}"
                                                           FontSize="11"
                                                           FontAutoScalingEnabled="False"
                                                           TextColor="{DynamicResource AppTextMuted}"
                                                           IsVisible="{Binding HasCode}" />
                                                </VerticalStackLayout>
                                                    <HorizontalStackLayout Grid.Column="1"
                                                                           IsVisible="{DynamicResource ShowRateUpdateTime}"
                                                                           Margin="4,0,0,0"
                                                                           Spacing="2"
                                                                           VerticalOptions="Center"
                                                                           SemanticProperties.Description="{Binding UpdateTimeAccessibility}">
                                                        <views:LucideIcon Kind="Clock3" Size="10"
                                                                          IconColor="#8A8A8A" />
                                                        <Label Text="{Binding UpdateTime}"
                                                               FontSize="10"
                                                               FontAutoScalingEnabled="False"
                                                               TextColor="{DynamicResource AppTextMuted}"
                                                               VerticalTextAlignment="Center"
                                                               LineBreakMode="NoWrap" />
                                                    </HorizontalStackLayout>
                                                </Grid>

                                              <Label Grid.Column="3"
                                                     Text="{Binding BuyDisplay}"
 	                                                   FontSize="14"
 	                                                   FontAttributes="Bold"
 	                                                   FontAutoScalingEnabled="False"
 	                                                   TextColor="{DynamicResource RatePriceText}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       LineBreakMode="NoWrap"
                                                       MaxLines="1" />

                                                <VerticalStackLayout Grid.Column="4"
                                                                     Spacing="1"
                                                                     HorizontalOptions="Center"
                                                                     VerticalOptions="Center">
	                                                    <Label Text="{Binding SellDisplay}"
 	                                                           FontSize="14"
 	                                                           FontAttributes="Bold"
 	                                                           FontAutoScalingEnabled="False"
 	                                                           TextColor="{DynamicResource RatePriceText}"
                                                            HorizontalTextAlignment="Center"
                                                            LineBreakMode="NoWrap"
                                                            MaxLines="1" />
                                                    <HorizontalStackLayout Spacing="3" HorizontalOptions="Center"
                                                                           SemanticProperties.Description="Satış fiyatının yüzde değişimi">
                                                        <views:LucideIcon Kind="TrendingUp" Size="11" IconColor="#1FA463" IsVisible="{Binding IsUp}" />
                                                        <views:LucideIcon Kind="TrendingDown" Size="11" IconColor="#D84555" IsVisible="{Binding IsDown}" />
                                                    <Label Text="{Binding ChangePercent}"
                                                           FontSize="9"
                                                           FontAutoScalingEnabled="False"
                                                           TextColor="{DynamicResource AppTextMuted}"
                                                           HorizontalTextAlignment="Center"
                                                           LineBreakMode="NoWrap"
                                                           MaxLines="1"
                                                           Loaded="OnTrendLabelLoaded"
                                                           Unloaded="OnTrendLabelUnloaded">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsUp}"
                                                                         Value="True">
                                                                <Setter Property="TextColor"
                                                                        Value="{DynamicResource AppPositive}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsDown}"
                                                                         Value="True">
                                                                <Setter Property="TextColor"
                                                                        Value="{DynamicResource AppNegative}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
 	                                                    </Label>
	                                                </HorizontalStackLayout>
 	                                                </VerticalStackLayout>
                                                <BoxView Grid.ColumnSpan="5"
                                                         HeightRequest="1"
                                                         Color="{DynamicResource RateDivider}"
                                                         VerticalOptions="End" />
 	                                        </Grid>
 	                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </RefreshView>

        <Grid x:Name="LoadingOverlay"
              Grid.Row="0"
              BackgroundColor="{DynamicResource AppLoadingBackground}"
              IsVisible="{Binding IsInitialLoading}">
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="16">
                <Border WidthRequest="240"
                        HeightRequest="240"
                        Padding="0"
                        StrokeThickness="0"
                        BackgroundColor="#050505">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Grid>
                        <Image x:Name="LoadingLogoImage"
                               Source="aslan_logo.png"
                               WidthRequest="240"
                               HeightRequest="240"
                               Aspect="AspectFit" />
                        <Label x:Name="LoadingLogoFallback"
                               IsVisible="False"
                               FontSize="58"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AppAccent}"
                               FontAutoScalingEnabled="False"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Grid>
                </Border>
                <ActivityIndicator IsRunning="{Binding IsInitialLoading}"
                                   Color="{DynamicResource AppAccent}"
                                   WidthRequest="38"
                                   HeightRequest="38" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="TickerViewport"
              Grid.Row="1"
              HeightRequest="54"
              Padding="0"
              BackgroundColor="{DynamicResource AppTickerBackground}"
              IsClippedToBounds="True"
              IsVisible="{Binding IsTickerVisible}">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnTickerPanUpdated" />
            </Grid.GestureRecognizers>

            <HorizontalStackLayout x:Name="TickerContent"
                                   Spacing="28"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center">
                <Border x:Name="TickerSegment"
                        Padding="18,7"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppTickerCardBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout x:Name="TickerSegmentContent"
                                           Spacing="14" />
                </Border>

                <Border x:Name="TickerSegmentClone"
                        Padding="18,7"
                        Stroke="{DynamicResource AppBorder}"
                        StrokeThickness="1"
                        BackgroundColor="{DynamicResource AppTickerCardBackground}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <HorizontalStackLayout x:Name="TickerSegmentCloneContent"
                                           Spacing="14" />
                </Border>
            </HorizontalStackLayout>

            <Border x:Name="SalihTickerBorder"
                    IsVisible="False"
                    Margin="16,0,16,6"
                    Stroke="{DynamicResource AppBorder}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource AppTickerCardBackground}"
                    VerticalOptions="Center"
                    HeightRequest="42">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="21" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="36,*,36">
                    <!-- Left Static Icon Container -->
                    <Grid x:Name="SalihTickerLeftIconContainer"
                          Grid.Column="0"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />

                    <!-- Scrolling Content Viewport -->
                    <Grid Grid.Column="1"
                          IsClippedToBounds="True"
                          VerticalOptions="Center"
                          HeightRequest="36">
                        <HorizontalStackLayout x:Name="SalihTickerScrollingContent"
                                               Spacing="40"
                                               HorizontalOptions="Start"
                                               VerticalOptions="Center">
                            <HorizontalStackLayout x:Name="SalihTickerSegment"
                                                   Spacing="40"
                                                   VerticalOptions="Center" />
                            <HorizontalStackLayout x:Name="SalihTickerSegmentClone"
                                                   Spacing="40"
                                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Right Static Icon Container -->
                    <Grid x:Name="SalihTickerRightIconContainer"
                          Grid.Column="2"
                          VerticalOptions="Center"
                          HorizontalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SalihBottomNavigationContainer"
              Grid.Row="2"
              IsVisible="False"
              HeightRequest="68"
              BackgroundColor="Transparent" />
    </Grid>
</ContentPage>
