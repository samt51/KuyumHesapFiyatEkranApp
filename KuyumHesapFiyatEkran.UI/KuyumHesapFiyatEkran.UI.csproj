<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Opt in to the current Google Play Android target without changing Apple builds. -->
		<TargetFrameworks Condition="'$(GooglePlayRelease)' == 'true' And '$(Brand)' == 'SalihCetinkaya'">net10.0-android36.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>KuyumHesapFiyatEkran.UI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Brand Condition="'$(Brand)' == ''">Aslan</Brand>

		<!-- Display name -->
		<ApplicationTitle>Aslan Kuyumculuk</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.aslankuyumculuk.kuyumhesap</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.2</ApplicationDisplayVersion>
		<ApplicationVersion>7</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Brand)' == 'SalihCetinkaya'">
		<ApplicationTitle>Salih Ã‡etinkaya Kuyumcu</ApplicationTitle>
		<ApplicationId>com.salihcetinkaya.kuyumculuk</ApplicationId>
		<ApplicationId Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">com.salihcetinkaya.kuyumhesap</ApplicationId>
		<ApplicationDisplayVersion>1.0.9</ApplicationDisplayVersion>
		<ApplicationDisplayVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">1.0.10</ApplicationDisplayVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17</ApplicationVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">15</ApplicationVersion>
		<ApplicationVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">16</ApplicationVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Brand)' == 'MazlumKuyumculuk'">
		<ApplicationTitle>Mazlum Kuyumculuk</ApplicationTitle>
		<ApplicationId>com.mazlumkuyumculuk.kuyumhesap</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<AndroidManifestPlaceholders>tvBanner=@drawable/tv_banner</AndroidManifestPlaceholders>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Brand)' != 'MazlumKuyumculuk'">
		<AndroidManifestPlaceholders>tvBanner=@mipmap/appicon</AndroidManifestPlaceholders>
	</PropertyGroup>
	
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidEnableFastDeployment>false</AndroidEnableFastDeployment>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Remove="Resources\AppIcon\**\*" />
	</ItemGroup>

	<ItemGroup Condition="'$(Brand)' == 'SalihCetinkaya'">
		<!-- App Icon for Salih Cetinkaya -->
		<MauiIcon Include="Resources\AppIcon\SalihCetinkaya\appicon.png" Color="#050505" />
		<!-- Splash Screen for Salih Cetinkaya -->
		<MauiSplashScreen Include="Resources\Splash\SalihCetinkaya\splash.png" Color="#050505" BaseSize="180,180" />
	</ItemGroup>

	<ItemGroup Condition="'$(Brand)' == 'MazlumKuyumculuk'">
		<MauiImage Include="Resources\Images\MazlumKuyumculuk\tv_banner.png" />

		<MauiIcon
				Include="Resources\AppIcon\MazlumKuyumculuk\appicon.png"
				BaseSize="1024,1024"
				Color="#050505" />

		<MauiSplashScreen
				Include="Resources\Splash\MazlumKuyumculuk\transparent.svg"
				Color="#FFFFFF"
				BaseSize="1,1" />
	</ItemGroup>

	<ItemGroup Condition="'$(Brand)' == 'Aslan'">
		<!-- App Icon for Aslan -->
		<MauiIcon Include="Resources\AppIcon\Aslan\appicon.svg"
		          ForegroundFile="Resources\AppIcon\Aslan\appiconfg.png"
		          Color="#050505" />

		<!-- Splash Screen for Aslan -->
		<MauiSplashScreen Include="Resources\Splash\splash.png"
		                  Color="#050505"
		                  BaseSize="180,180" />
	</ItemGroup>

	<ItemGroup>

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Include="Resources\Images\SalihCetinkaya\*.png" />
		<MauiImage Include="Resources\Images\MazlumKuyumculuk\mazlum_splash_logo.png" Condition="'$(Brand)' == 'MazlumKuyumculuk'" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KuyumHesapFiyatEkran.Core\KuyumHesapFiyatEkran.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="appsettings.json" />
		<EmbeddedResource Include="appsettings.Production.json" />
		<EmbeddedResource Include="Brands\$(Brand)\appsettings.json" LogicalName="KuyumHesapFiyatEkran.UI.appsettings.Brand.json" />

	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Resources\AppIcon\MazlumKuyumculuk\" />
	</ItemGroup>

</Project>

